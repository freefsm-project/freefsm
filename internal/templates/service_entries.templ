package templates

import "fmt"
import "slices"
import "github.com/google/uuid"
import "github.com/freefsm-project/freefsm/internal/authorization"

templ ServiceEntryHistory(entries []authorization.ServiceEntry) {
 for _,entry := range entries {
  <article>
   <h2>{entry.ServiceDate}</h2><p>{entry.Summary}</p><p>{entry.JobTitle}</p>
   <p>Responsible:
    for _,name := range entry.ResponsibleNames {
     <span>{name} </span>
    }
   </p>
   <p>Revision accepted <time>{entry.RevisedAt.Format("2006-01-02 15:04:05Z07:00")}</time></p>
  </article>
 }
 if len(entries)==0 {
  <p>No Service Entries</p>
 }
}

templ ServiceEntries(jobID,assetID int64, page authorization.ServiceEntryPage) {
 @Layout("Asset Service Entries") {
  <h1>Asset Service Entries</h1>
  @ServiceEntryHistory(page.Entries)
  if page.CanCreate {
   <h2>Record service</h2>
   <form id="service-entry-create" method="post" action={templ.URL(fmt.Sprintf("/jobs/%d/assets/%d/service-entries",jobID,assetID))}>
    <input type="hidden" name="csrf_token" value={csrfToken(ctx)}/>
    <input type="hidden" name="operation_id" value={uuid.NewString()}/>
    <input type="hidden" name="link_id" value={fmt.Sprint(page.LinkID)}/>
    <label>Service date<input name="service_date" type="date" required/></label>
    <label>Summary<textarea name="summary" required></textarea></label>
    <label>Responsible Product Users<select name="responsible_user_id" multiple required>
     for _,user := range page.Participants {
      <option value={fmt.Sprint(user.ID)}>{user.Name}</option>
     }
    </select></label>
    <button type="submit">Record Service Entry</button>
   </form>
  }
  if page.CanRevise {
   for _,entry := range page.Entries {
    if entry.JobID==jobID {
    <form data-service-revision method="post" action={templ.URL(fmt.Sprintf("/jobs/%d/assets/%d/service-entries/%d",jobID,assetID,entry.ID))}>
     <h2>Revise service</h2>
     <input type="hidden" name="csrf_token" value={csrfToken(ctx)}/>
     <input type="hidden" name="revision" value={entry.Revision}/>
     <input type="hidden" name="link_id" value={fmt.Sprint(page.LinkID)}/>
     <input type="hidden" name="operation_id" value={uuid.NewString()}/>
     <label>Service date<input name="service_date" type="date" value={entry.ServiceDate} required/></label>
     <label>Summary<textarea name="summary" required>{entry.Summary}</textarea></label>
     <label>Responsible Product Users<select name="responsible_user_id" multiple required>
      for _,user := range page.Participants {
       <option value={fmt.Sprint(user.ID)} selected?={slices.Contains(entry.ResponsibleUsers,user.ID)}>{user.Name}</option>
      }
     </select></label>
     <p>The originally read revision is required. Stale text cannot overwrite another revision.</p>
     <button type="submit">Revise Service Entry</button>
    </form>
    }
   }
  }
 }
}

templ OfficeServiceEntryHistory(entries []authorization.ServiceEntry) {
 @Layout("Asset Service Entries") {
  <h1>Asset Service Entries</h1>
  @ServiceEntryHistory(entries)
 }
}
