package templates

import "fmt"

templ EstimateForm(p EstimateFormPageData) {
	@Layout(estimateFormTitle(p.IsNew)) {

		<form action={ templ.URL(estimateFormAction(p.IsNew, p.Estimate.ID)) } method="post" autocomplete="off" class="compact-form" hx-boost="false">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			<input type="hidden" name="default_line_description" value={ p.DefaultLineDescription }/>
			<label>Terms<textarea name="terms" rows="3">{ p.Estimate.Terms }</textarea></label>
			if p.Estimate.TermsUnknown {
				<p>Legacy terms were not recorded. Review and enter this document's terms before generating a new PDF. Blank explicitly records no terms.</p>
			}
			<label>Valid through (optional)<input type="date" name="valid_through" value={ p.Estimate.ValidThrough }/></label>
			<label>
				Customer <small class="required-marker">*</small>
				<select name="customer_id" required disabled?={ !commercialAnchorsEditable(ctx,"estimate",p.IsNew) }>
					<option value="">Select a customer...</option>
					for _, c := range p.Customers {
						<option value={ fmt.Sprintf("%d", c.Value) } selected?={ p.Estimate.CustomerID == c.Value }>{ c.Label }</option>
					}
				</select>
				if p.Errors["customer_id"] != "" {
					<small class="error-msg">{ p.Errors["customer_id"] }</small>
				}
			</label>
			<label>
				Job (optional)
				<select name="job_id" disabled?={ !commercialAnchorsEditable(ctx,"estimate",p.IsNew) }>
					<option value="0">No job</option>
					for _, j := range p.Jobs {
						<option value={ fmt.Sprintf("%d", j.Value) } selected?={ p.Estimate.JobID == j.Value }>{ j.Label }</option>
					}
				</select>
			</label>
			if !commercialAnchorsEditable(ctx,"estimate",p.IsNew) {
				<input type="hidden" name="customer_id" value={ fmt.Sprint(p.Estimate.CustomerID) }/>
				<input type="hidden" name="job_id" value={ fmt.Sprint(p.Estimate.JobID) }/>
			}
			<div class="grid">
				<label>
					Title <small class="required-marker">*</small>
					<input type="text" name="title" value={ p.Estimate.Title } required autofocus/>
					if p.Errors["title"] != "" {
						<small class="error-msg">{ p.Errors["title"] }</small>
					}
				</label>
			</div>
			if capturedPricingVisible(ctx,"estimate",p.Estimate.ID,p.IsNew) {
				<label>Tax Rate<input type="text" name="tax_rate" value={ p.Estimate.TaxRate } placeholder="e.g. 8.25%"/></label>
			}
			<label>
				Notes
				<textarea name="notes" rows="3">{ p.Estimate.Notes }</textarea>
			</label>
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields, EditMode: true})
			if capturedPricingVisible(ctx,"estimate",p.Estimate.ID,p.IsNew) {
				@LineItemEditor(LineItemEditorData{ItemsJSON: p.ItemsJSON, ExistingItemsJSON: p.ExistingItemsJSON, CustomersJSON: p.CustomersJSON})
			} else {
				<p>Captured pricing is not available with your current permissions. Saving other details retains it.</p>
			}
			if p.IsNew {
				@DocumentDefaultPicker(p.DefaultsJSON,p.PreserveEntered)
			} else if commercialAnchorsEditable(ctx,"estimate",false) {
				@CommercialCustomerReview(p.DefaultsJSON,p.Estimate.CustomerID)
			}
			<div class="entity-form-actions">
				<button type="submit">Save</button>
				<a href={ templ.URL(navigationReturnURL(ctx, "/estimates")) } role="button" class="outline">Cancel</a>
			</div>
		</form>
	}
}
