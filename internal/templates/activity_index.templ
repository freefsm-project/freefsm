package templates

templ ActivityIndex(p ActivityPageData) {
	@Layout("Activity") {
		if p.ExportURL!="" {
			<a href={ templ.URL(p.ExportURL) }>Export activity CSV</a>
		}
		<a href="/exports">My CSV exports</a>
		<form method="get" action={ templ.URL(p.RefreshURL) }>
			<label>From (company date, inclusive)<input type="date" name="from" value={ p.Filters.Get("from") }/></label>
			<label>Until (company date, exclusive)<input type="date" name="until" value={ p.Filters.Get("until") }/></label>
			<label>Actor user ID<input type="number" min="1" name="actor" value={ p.Filters.Get("actor") }/></label>
			<label>Record type<input type="text" name="type" value={ p.Filters.Get("type") }/></label>
			<label>Exact record type<input type="text" name="object_type" value={ p.Filters.Get("object_type") }/></label>
			<label>Exact record ID<input type="number" min="1" name="object_id" value={ p.Filters.Get("object_id") }/></label>
			<label>Action<input type="text" name="action" value={ p.Filters.Get("action") }/></label>
			for _, key := range []string{"type", "action"} {
				if len(p.Filters[key]) > 1 {
					for _, value := range p.Filters[key][1:] {
						<input type="hidden" name={ key } value={ value }/>
					}
				}
			}
			if p.Filters.Get("conversion") != "" {
				<input type="hidden" name="conversion" value={ p.Filters.Get("conversion") }/>
			}
			<button type="submit">Refresh activity</button>
			<a href={ templ.URL(p.RefreshURL) }>Clear filters</a>
		</form>
		if p.UpdatedAt != "" {
			<p role="status">Updated at { p.UpdatedAt }</p>
		}
		if p.Failed {
			<p role="alert">Activity could not be loaded. Refresh activity to retry. Previous rows are withheld until current access can be checked.</p>
		} else if len(p.Entries) == 0 {
			<p>No activity recorded yet.</p>
		} else {
			<div class="activity-list activity-list-compact">
				for _, e := range p.Entries {
					<div class="activity-item activity-item-compact">
						<span class="activity-icon">{ e.Icon }</span>
						<div class="activity-body">
							<span class="activity-text activity-text-compact">
								<strong>{ e.ActorName }</strong>
								{" "}
								<span class={ activityActionClass(e.Action) }>{ activityVerb(e.Action) }</span>
								{" "}
								if e.Action == "tag_attached" {
									{ "tag " }
									<strong>{ e.Metadata.TagName }</strong>
									{ " to " }
								} else if e.Action == "tag_detached" {
									{ "tag " }
									<strong>{ e.Metadata.TagName }</strong>
									{ " from " }
								} else if e.Action == "file_uploaded" {
									{ "file " }
									<strong>{ e.Metadata.FileName }</strong>
									{ " to " }
								} else if e.Action == "file_deleted" {
									{ "file " }
									<strong>{ e.Metadata.FileName }</strong>
									{ " from " }
								} else if e.Action == "status_changed" {
									{ "status from " }
									<em>{ e.Metadata.OldStatus }</em>
									{ " to " }
									<em>{ e.Metadata.NewStatus }</em>
									{ " on " }
								} else if e.Action == "payment_recorded" {
									{ "payment of $" + e.Metadata.Amount + " to " }
								} else if e.Action == "payment_deleted" {
									{ "payment of $" + e.Metadata.Amount + " from " }
								} else if e.Action == "comment_added" || e.Action == "comment_deleted" {
									{ "a comment on " }
								} else if e.Action == "settings_updated" && e.Metadata.Changed != "" {
									{ "(" + e.Metadata.Changed + ") of " }
								}
								if e.Action != "password_changed" {
									if e.EntityURL != "" {
										<a href={ e.EntityURL }>{ e.EntityName }</a>
									} else {
										{ e.EntityName }
									}
								}
								{" "}
								if e.TargetType != "" {
									<span class="shared-widget-muted">({ e.TargetType })</span>
								}
							</span>
							@BackupActivityPreview(e)
							@ActivityFacts(e.Metadata)
							if e.Metadata.CommentPreview != "" && e.Action == "comment_added" {
								<p class="activity-preview activity-preview-compact">{ TruncateText(e.Metadata.CommentPreview, 100) }</p>
							}
							if ScheduleActivityDetail(e.Metadata) != "" && (e.Action == "scheduled" || e.Action == "rescheduled" || e.Action == "dispatched") {
								<p class="activity-preview activity-preview-compact">{ ScheduleActivityDetail(e.Metadata) }</p>
							}
						</div>
						<small class="activity-time activity-time-compact">Accepted { e.CreatedAt }</small>
					</div>
				}
			</div>
			if p.NewerURL != "" || p.OlderURL != "" {
				<nav class="pagination-nav" aria-label="Activity pages">
					if p.NewerURL != "" {
						<a href={ templ.URL(p.NewerURL) } role="button" class="outline">Newer</a>
					}
					if p.OlderURL != "" {
						<a href={ templ.URL(p.OlderURL) } role="button" class="outline">Older</a>
					}
				</nav>
			}
		}
	}
}
