package templates

import "fmt"

templ InvoiceShow(p InvoiceDetail) {
	@Layout(recordedNumber(p.NumberLabel,fmt.Sprintf("Invoice record %d — identity requires review",p.ID))+": "+p.Title) {
		<div class="work-item-detail">
		if p.ArchivedAt == "" {
			<div class="work-item-detail-actions">
			<div class="work-item-detail-action-group">
			if p.CanFinalize && detailCan(ctx,"finalize") {
				<form action={ templ.URL(fmt.Sprintf("/invoices/%d/finalize", p.ID)) } method="post" hx-confirm={ fmt.Sprintf("Finalize Invoice %q (record %d) using its reviewed content and dates?", p.Title, p.ID) }>
					<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
					<button type="submit">Finalize Invoice</button>
				</form>
			}
			if detailCan(ctx,"pdf") {
				<a href={ templ.URL(fmt.Sprintf("/invoices/%d/pdf/preview", p.ID)) } role="button" class="outline">PDF</a>
			}
			if detailCan(ctx,"edit") {
				<a href={ templ.URL(fmt.Sprintf("/invoices/%d/edit", p.ID)) } role="button" class="outline" aria-label={ fmt.Sprintf("Edit %s", p.Title) }>Edit</a>
			}
			if p.CanRevert && detailCan(ctx,"revert") {
				<a href={ templ.URL(fmt.Sprintf("/invoices/%d/revert-to-estimate", p.ID)) } class="outline">Review reversion to Estimate</a>
			}
			if detailCan(ctx,"archive") {
				<form action={ templ.URL(fmt.Sprintf("/invoices/%d/delete", p.ID)) } method="post" hx-confirm="Delete this invoice?">
					<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
					<button class="outline contrast" aria-label={ fmt.Sprintf("Delete %s", p.Title) }>Delete</button>
				</form>
			}
			</div>
			</div>
		}
		if p.Converted && !p.CanRevert && len(p.RevertBlockers) > 0 && detailCan(ctx,"revert") {
			<aside>
				<strong>Cannot revert to Estimate yet</strong>
				<ul>
					for _, blocker := range p.RevertBlockers {
						<li>{ blocker }</li>
					}
				</ul>
			</aside>
		}
		if p.ArchivedAt != "" {
			<div class="work-item-detail-archive-banner">
				<span>Archived on { p.ArchivedAt }</span>
				<div class="work-item-detail-action-group">
				if detailCan(ctx,"pdf") {
					<a href={ templ.URL(fmt.Sprintf("/invoices/%d/pdf/preview", p.ID)) } role="button" class="outline">PDF</a>
				}
				if detailCan(ctx,"restore") {
					<form action={ templ.URL(fmt.Sprintf("/invoices/%d/restore", p.ID)) } method="post">
						<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
						<button type="submit" class="outline">Restore</button>
					</form>
				}
				</div>
			</div>
		}
		if len(p.Tags) > 0 || true {
			@TagWidget(TagWidgetData{BaseURL: fmt.Sprintf("/invoices/%d", p.ID), Tags: p.Tags, AllTags: p.AllTags, ReadOnly: p.ArchivedAt != ""})
		}
		if len(p.CustomFields) > 0 {
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields})
			@FieldValuesLink("invoice",p.ID,p.ArchivedAt=="")
		}
		<table class="work-item-detail-meta">
			<tbody>
				if canCustomer(ctx,"view") && p.Customer != "" {
					<tr><th>Customer</th><td><a href={ templ.URL(fmt.Sprintf("/customers/%d", p.CustomerID)) }>{ p.Customer }</a></td></tr>
				} else if p.JobID > 0 && canCustomer(ctx,"context") && visibleCustomerContext(ctx,p.JobID) {
					<tr><th>Customer</th><td><a href={ templ.URL(fmt.Sprintf("/jobs/%d/customer-context",p.JobID)) }>{ p.Customer }</a></td></tr>
				}
				<tr><th>Invoice Number</th><td>{ recordedNumber(p.NumberLabel,fmt.Sprintf("Invoice record %d — identity requires review",p.ID)) }</td></tr>
				if p.AssetID > 0 {
					<tr><th>Asset</th><td><a href={ templ.URL(fmt.Sprintf("/assets/%d", p.AssetID)) }>{ p.AssetName }</a></td></tr>
				}
				<tr><th>Status</th><td>
					if p.ArchivedAt == "" && len(p.Statuses)>0 && detailCan(ctx,"status") {
						<span class="status-badge" style={ badgeStyle(p.StatusColor) }>{ p.StatusName }</span>
					}
					@StatusControl("invoice", p.ID, p.StatusID, p.StatusName, p.StatusColor, p.Statuses, p.ArchivedAt == "" && len(p.Statuses)>0 && detailCan(ctx,"status"))
				</td></tr>
				if detailCan(ctx,"settlement") {
					<tr><th>Settlement State</th><td><span class="status-badge">{ string(p.Settlement.State) }</span></td></tr>
				}
				<tr><th>Invoice Date</th><td>{ p.InvoiceDateDisplay }</td></tr>
				<tr><th>Due Date</th><td>{ p.DueDateDisplay }</td></tr>
				if detailCan(ctx,"pricing") {
					<tr><th>Tax Rate</th><td>{ p.TaxRate }</td></tr>
				}
			</tbody>
		</table>
		if detailCan(ctx,"pricing") {
			<h3>Line Items</h3>
			<table>
				<thead>
					<tr>
						<th>Item</th>
						<th>Description</th>
						<th>Qty</th>
						<th>Price</th>
						<th>Tax</th>
						<th>Total</th>
					</tr>
				</thead>
				<tbody>
					if len(p.LineItems)==0 {
						<tr><td colspan="6">No line items</td></tr>
					}
					for index, li := range p.LineItems {
						<tr>
							<td>{ li.Title }<small>{ lineAdjustmentSummary(li) }</small></td>
							<td>{ li.Description }</td>
							<td>{ commercialQuantity(li) }</td>
							<td>{ commercialCurrency(commercialPrice(li)) }</td>
							<td>
								if li.Taxable {
									{ p.TaxRate }
								} else {
									No
								}
							</td>
							<td>{ commercialCurrency(documentLineAmount(li,p.Financial,index)) }</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="work-item-detail-totals">
				<p>{ documentAdjustmentSummary(p.Financial) }</p>
				<p><strong>Subtotal: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"subtotal")) }</strong></p>
				<p><strong>Tax: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"tax")) }</strong></p>
				<p><strong>Grand Total: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"total")) }</strong></p>
			</div>
		}
		if detailCan(ctx,"settlement") && detailCan(ctx,"pricing") {
		<div class="work-item-detail-totals">
			<p><strong>Total: { cents(p.Settlement.TotalCents) }</strong></p>
			<p><strong>Settled: { cents(p.Settlement.SettledCents) }</strong></p>
			<p><strong>Amount Due: { cents(p.Settlement.AmountDueCents) }</strong></p>
		</div>
		}
		if detailCan(ctx,"settlement") && len(p.Settlement.Payments) > 0 {
			<h3>Payments</h3>
			<div style="overflow-x: auto;">
			<table>
				<thead>
					<tr>
						<th>Date</th>
						<th>Method</th>
						<th>Reference</th>
						<th>Amount</th>
						<th>State / Action</th>
					</tr>
				</thead>
				<tbody>
					for _, pmt := range p.Settlement.Payments {
						<tr>
							<td>{ pmt.ReceivedDate.Format("2006-01-02") }</td>
							<td>{ pmt.MethodLabel }<small>{ pmt.OtherDescription }</small></td>
							<td>{ pmt.Reference }</td>
							<td>{ cents(pmt.AmountCents) } ({ cents(pmt.AppliedCents) } applied)</td>
							<td>
							if pmt.Reversal != nil {
								Reversed { pmt.Reversal.EffectiveDate.Format("2006-01-02") }: { pmt.Reversal.Reason } — { pmt.Reversal.Reference } — { pmt.Reversal.Notes }
							} else if p.ArchivedAt == "" && detailCan(ctx,"reverse-payment") {
									<a href={ templ.URL(fmt.Sprintf("/customers/%d/refunds", p.Settlement.CustomerID)) }>Review Payment reversal</a>
							}
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
		if detailCan(ctx,"settlement") && len(p.Settlement.Applications) > 0 {
			<h3>Credit Applications</h3>
			<div style="overflow-x: auto;">
			<table><tbody>
			for _, a := range p.Settlement.Applications {
				<tr><td>{ a.EffectiveDate.Format("2006-01-02") }</td><td>{ cents(a.AmountCents) }</td><td>
				if a.Reversal != nil {
					Reversed: { a.Reversal.Reason }
				} else if p.ArchivedAt == "" && detailCan(ctx,"reverse-application") {
					<a href={ templ.URL(fmt.Sprintf("/invoices/%d/credit",p.ID)) }>Reverse Application</a>
				}
				</td></tr>
			}
			</tbody></table>
			</div>
		}
		if p.ArchivedAt == "" && detailCan(ctx,"payment") {
		<details open>
			<summary>Record Payment</summary>
			if p.PaymentEligible {
				<p>Current Invoice due: { cents(p.PaymentDueCents) }. The full Payment must fit when accepted.</p>
			} else {
				<p>Payment unavailable: this Invoice must be active, finalized, non-Void and have a positive amount due.</p>
			}
			<form action={ templ.URL(fmt.Sprintf("/invoices/%d/payments", p.ID)) } method="post" hx-boost="false" data-bounded-payment data-payment-eligible={ fmt.Sprint(p.PaymentEligible) } class="inline-add-form">
				<fieldset disabled?={ !p.PaymentEligible }>
				<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
				<input type="hidden" name="idempotency_key" value={ p.PaymentKey }/>
				<div class="grid">
					<label>
						Amount
						<input type="number" name="amount" step="0.01" min="0.01" required/>
					</label>
					<label>
						Method
						<select name="method">
							for _,method := range p.PaymentMethods {
								<option value={ string(method.ID) }>{ method.Label }</option>
							}
						</select>
					</label>
				</div>
				<div class="grid">
					<label>
						Date
						<input type="date" name="date" value={ today(ctx) }/>
					</label>
					<label>
						Reference
						<input type="text" name="reference" placeholder="Check #, transaction ID"/>
					</label>
				</div>
				<label>
					Other method description (required for Other)
					<input type="text" name="other_description" maxlength="500"/>
				</label>
				<p>Record only the receipt. Do not enter payment credentials or card details.</p>
				<label>
					Notes
					<input type="text" name="notes" placeholder="Optional"/>
				</label>
				<button type="submit">Record Payment</button>
				</fieldset>
			</form>
			<div data-payment-reconciliation role="status" aria-live="polite"></div>
			<script src="/static/js/bounded-payment.js" defer></script>
		</details>
		}
		if detailCan(ctx,"apply-credit") || detailCan(ctx,"reverse-application") {
			<a href={ templ.URL(fmt.Sprintf("/invoices/%d/credit",p.ID)) }>Apply Credit / Reverse Application</a>
		}
		if p.Notes != "" {
			<h3>Notes</h3>
			<p>{ p.Notes }</p>
		}
		@DeliveryHistory("invoice", p.ID, p.Deliveries, p.ArchivedAt != "")
		if p.ArchivedAt != "" {
			<div hx-get={ templ.URL(fmt.Sprintf("/invoices/%d/comments?read_only=1", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
				<p>Loading comments...</p>
			</div>
		} else {
			<div hx-get={ templ.URL(fmt.Sprintf("/invoices/%d/comments", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
				<p>Loading comments...</p>
			</div>
		}
	<div class="files-card">
		if p.ArchivedAt == "" {
			@FileUploadWidget("invoice", p.ID, fmt.Sprintf("/invoices/%d", p.ID))
		}
		@FileList(p.FileList)
	</div>
	@CommercialHistoryPanel("invoice",p.ID)
	<div hx-get={ templ.URL(fmt.Sprintf("/invoices/%d/activity", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
		<p>Loading activity...</p>
	</div>
	<p class="work-item-detail-back"><a href="/invoices">&larr; Back to Invoices</a></p>
		</div>
	}
}
