package templates

import "fmt"

templ DocumentEmailCompose(p DocumentEmailData) {
	@Layout("Email "+p.Title) {
		<p><a href={ templ.URL(p.BackURL) }>&larr; Back to Preview</a></p>
		if p.Error != "" {
			<article class="document-error">{ p.Error }</article>
		}
		<form action={ templ.URL(p.ActionURL) } method="post" hx-boost="false">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			<input type="hidden" name="idempotency_key" value={ p.IdempotencyKey }/>
			if p.PDFVersion > 0 {
				<input type="hidden" name="pdf_version" value={ fmt.Sprint(p.PDFVersion) }/>
				<p>Selected PDF version { fmt.Sprint(p.PDFVersion) }. Sending retains these exact saved bytes.</p>
				if p.PDFStale {
					<p role="alert">This selected PDF is stale.</p>
					<label><input type="checkbox" name="confirm_stale_pdf" value="1" checked?={ p.ConfirmStalePDF } required/> I confirm sending this stale PDF version</label>
				}
			}
			<label>
				To
				<input type="text" name="to" value={ p.To } required/>
			</label>
			<label>
				CC
				<input type="text" name="cc" value={ p.CC }/>
			</label>
			<label>
				BCC
				<input type="text" name="bcc" value={ p.BCC }/>
			</label>
			<p class="settings-help">Separate multiple email addresses with commas.</p>
			<label>
				Subject
				<input type="text" name="subject" value={ p.Subject } required/>
			</label>
			<label>
				Body
				<textarea name="body" rows="10">{ p.Body }</textarea>
			</label>
			<label>HTML body (optional; blank uses plain text)<textarea name="html_body" rows="10">{ p.HTMLBody }</textarea></label>
			<p class="settings-help">Provide a plain-text or HTML message. Each recipient receives a separately tracked email.</p>
			<button type="submit">Queue Email</button>
		</form>
	}
}
