package templates

import "fmt"

templ EstimateShow(p EstimateDetail) {
	@Layout(recordedNumber(p.NumberLabel,fmt.Sprintf("Estimate record %d — identity requires review",p.ID))+": "+p.Title) {
		<div class="work-item-detail">
		if p.ArchivedAt == "" {
			<div class="work-item-detail-actions">
			<div class="work-item-detail-action-group">
			if detailCan(ctx,"pdf") {
				<a href={ templ.URL(fmt.Sprintf("/estimates/%d/pdf/preview", p.ID)) } role="button" class="outline">PDF</a>
			}
			if detailCan(ctx,"edit") {
				<a href={ templ.URL(fmt.Sprintf("/estimates/%d/edit", p.ID)) } role="button" class="outline" aria-label={ fmt.Sprintf("Edit %s", p.Title) }>Edit</a>
			}
			if p.CanConvert && detailCan(ctx,"convert") {
				<a href={ templ.URL(fmt.Sprintf("/estimates/%d/convert", p.ID)) } role="button">Convert to Invoice</a>
			}
			if detailCan(ctx,"archive") {
				<form action={ templ.URL(fmt.Sprintf("/estimates/%d/delete", p.ID)) } method="post" hx-confirm="Archive this estimate as read-only history? Pending deliveries will be cancelled.">
					<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
					<button class="outline contrast" aria-label={ fmt.Sprintf("Archive %s", p.Title) }>Archive</button>
				</form>
			}
			</div>
			</div>
		}
		if p.ConvertBlocker != "" && detailCan(ctx,"convert") {
			<p class="secondary">{ p.ConvertBlocker }</p>
		}
		if p.ArchivedAt != "" {
			<div class="work-item-detail-archive-banner">
				<span>Archived on { p.ArchivedAt }</span>
				<div class="work-item-detail-action-group">
				if detailCan(ctx,"pdf") {
					<a href={ templ.URL(fmt.Sprintf("/estimates/%d/pdf/preview", p.ID)) } role="button" class="outline">PDF</a>
				}
				if detailCan(ctx,"restore") {
					<form action={ templ.URL(fmt.Sprintf("/estimates/%d/restore", p.ID)) } method="post">
						<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
						<button type="submit" class="outline">Restore</button>
					</form>
				}
				</div>
			</div>
		}
		if len(p.Tags) > 0 || true {
			@TagWidget(TagWidgetData{BaseURL: fmt.Sprintf("/estimates/%d", p.ID), Tags: p.Tags, AllTags: p.AllTags, ReadOnly: p.ArchivedAt != ""})
		}
		if len(p.CustomFields) > 0 {
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields})
			@FieldValuesLink("estimate",p.ID,p.ArchivedAt=="")
		}
		<table class="work-item-detail-meta">
			<tbody>
				if canCustomer(ctx,"view") && p.Customer != "" {
					<tr><th>Customer</th><td><a href={ templ.URL(fmt.Sprintf("/customers/%d", p.CustomerID)) }>{ p.Customer }</a></td></tr>
				} else if p.JobID > 0 && canCustomer(ctx,"context") && visibleCustomerContext(ctx,p.JobID) {
					<tr><th>Customer</th><td><a href={ templ.URL(fmt.Sprintf("/jobs/%d/customer-context",p.JobID)) }>{ p.Customer }</a></td></tr>
				}
				<tr><th>Status</th><td>@StatusControl("estimate", p.ID, p.StatusID, p.StatusName, p.StatusColor, p.Statuses, p.ArchivedAt == "" && detailCan(ctx,"status"))</td></tr>
				if detailCan(ctx,"pricing") {
					<tr><th>Tax Rate</th><td>{ p.TaxRate }</td></tr>
				}
			</tbody>
		</table>
		if detailCan(ctx,"pricing") {
			<h3>Line Items</h3>
			<table>
				<thead>
					<tr>
						<th>Item</th>
						<th>Description</th>
						<th>Qty</th>
						<th>Price</th>
						<th>Tax</th>
						<th>Total</th>
					</tr>
				</thead>
				<tbody>
					if len(p.LineItems)==0 {
						<tr><td colspan="6">No line items</td></tr>
					}
					for index, li := range p.LineItems {
						<tr>
							<td>{ li.Title }<small>{ lineAdjustmentSummary(li) }</small></td>
							<td>{ li.Description }</td>
							<td>{ commercialQuantity(li) }</td>
							<td>{ commercialCurrency(commercialPrice(li)) }</td>
							<td>
								if li.Taxable {
									{ p.TaxRate }
								} else {
									No
								}
							</td>
							<td>{ commercialCurrency(documentLineAmount(li,p.Financial,index)) }</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="work-item-detail-totals">
				<p>{ documentAdjustmentSummary(p.Financial) }</p>
				<p><strong>Subtotal: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"subtotal")) }</strong></p>
				<p><strong>Tax: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"tax")) }</strong></p>
				<p><strong>Grand Total: { commercialCurrency(documentAmount(p.LineItems,p.TaxRate,p.Financial,"total")) }</strong></p>
			</div>
		}
		if p.Notes != "" {
			<h3>Notes</h3>
			<p>{ p.Notes }</p>
		}
		@DeliveryHistory("estimate", p.ID, p.Deliveries, p.ArchivedAt != "")
		if p.ArchivedAt != "" {
			<div hx-get={ templ.URL(fmt.Sprintf("/estimates/%d/comments?read_only=1", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
				<p>Loading comments...</p>
			</div>
		} else {
			<div hx-get={ templ.URL(fmt.Sprintf("/estimates/%d/comments", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
				<p>Loading comments...</p>
			</div>
		}
	<div class="files-card">
		if p.ArchivedAt == "" {
			@FileUploadWidget("estimate", p.ID, fmt.Sprintf("/estimates/%d", p.ID))
		}
		@FileList(p.FileList)
	</div>
	@CommercialHistoryPanel("estimate",p.ID)
	<div hx-get={ templ.URL(fmt.Sprintf("/estimates/%d/activity", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
		<p>Loading activity...</p>
	</div>
	<p class="work-item-detail-back"><a href="/estimates">&larr; Back to Estimates</a></p>
		</div>
	}
}
