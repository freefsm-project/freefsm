package templates

import "fmt"

templ CustomerIndex(p CustomerListPageData) {
	@Layout("Customers") {
		@CustomerListContent(p)

		<div hx-get="/customers/activity" hx-trigger="load" hx-swap="innerHTML" class="shared-widget">
			<p>Loading recent activity...</p>
		</div>
	}
}

templ CustomerListContent(p CustomerListPageData) {
	<div id="customer-list-content" class="focused-list-content">
		@ListToolbar(ListToolbarData{
			Action: "/customers", Target: "#customer-list-content", Search: p.Search,
			SearchPlaceholder: "Search customers...", NewURL: customerNewURL(ctx), NewLabel: "New Customer",
			ShowFilter: true, Filters: filterValues("status", p.StatusFilter, "sort",p.Sort,"per_page",fmt.Sprint(p.PerPage)),
			FilterCount: activeFilterCount(filterValues("status", p.StatusFilter)),
		}) {
			<label>Customer status
				<select name="status">
					<option value="">All Statuses</option>
					for _, s := range []string{"lead", "opportunity", "customer", "lost", "inactive"} {
						<option value={ s } selected?={ p.StatusFilter == s }>{ s }</option>
					}
				</select>
			</label>
			<label>Sort
				<select name="sort">
					<option value="name" selected?={ p.Sort == "name" }>Name A–Z</option>
					<option value="name_desc" selected?={ p.Sort == "name_desc" }>Name Z–A</option>
					<option value="updated" selected?={ p.Sort == "updated" }>Recently updated</option>
				</select>
			</label>
			<label>Results per page
				<select name="per_page">
					for _, size := range []int{25,50,100} {
						<option value={ fmt.Sprint(size) } selected?={ p.PerPage == size }>{ fmt.Sprint(size) }</option>
					}
				</select>
			</label>
		}
		@CustomerTable(p)
	</div>
}

templ CustomerTable(p CustomerListPageData) {
	<div class="focused-list-results">
		<div class="work-queue-wrap">
			<table class="work-queue-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Phone</th>
					<th>Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				if len(p.Customers) == 0 {
					<tr><td colspan="5" class="work-queue-empty">
						if p.Search != "" || p.StatusFilter != "" {
							<p>No matches for these filters.</p>
							<a href="/customers">Clear filters</a>
						} else {
							<p>No customers yet.</p>
							if canCustomer(ctx,"create") {
								<a href="/customers/new" role="button" class="outline">Create your first customer</a>
							}
						}
					</td></tr>
				}
				for _, c := range p.Customers {
					<tr>
						<td>
							<a href={ templ.URL(fmt.Sprintf("/customers/%d", c.ID)) } class="work-queue-title">
								{ c.DisplayName }
							</a>
							if c.CompanyName != "" {
								<br/><small class="work-queue-muted">{ c.CompanyName }</small>
							}
						</td>
						<td>{ c.Email }</td>
						<td>{ c.Phone }</td>
						<td class="work-queue-status"><span class="status-badge" style={ badgeStyle(customerStatusColor(c.Status)) }>{ c.Status }</span></td>
						<td class="work-queue-actions">
							if canCustomer(ctx,"edit") {
							<a href={ templ.URL(fmt.Sprintf("/customers/%d/edit", c.ID)) } role="button" class="outline small" aria-label={ fmt.Sprintf("Edit %s", c.DisplayName) }>Edit</a>
							}
							if canCustomer(ctx,"archive") {
							<form action={ templ.URL(fmt.Sprintf("/customers/%d/delete", c.ID)) } method="post" hx-confirm={ fmt.Sprintf("Archive Customer %s? This removes the Customer from active lists and retains its history.", c.DisplayName) }>
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline contrast small" aria-label={ fmt.Sprintf("Archive Customer %s", c.DisplayName) }>Archive</button>
							</form>
							}
						</td>
					</tr>
				}
			</tbody>
			</table>
		</div>
		@Pagination(PaginationData{
			CurrentPage: p.Page,
			TotalPages:  p.TotalPages,
			BaseURL:     "/customers",
			Query:       listQuery(p.Search, filterValues("status", p.StatusFilter,"sort",p.Sort,"per_page",fmt.Sprint(p.PerPage)), nil),
			Target:      "#customer-list-content",
		})
	</div>
}
