package templates

import "fmt"

templ AssetTypeList(p AssetTypeListPageData) {
	<div class="asset-types-list settings-panel">
		<h3>Asset Types</h3>
		<table class="work-queue-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Order</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, t := range p.Types {
					<tr>
						<td>
							if t.Retired {
								<small>Retired</small>
							}
							<form id={ fmt.Sprintf("asset-type-update-%d", t.ID) } action={ templ.URL(fmt.Sprintf("/settings/asset-types/%d", t.ID)) } method="post">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<input type="text" name="name" value={ t.Name } aria-label={ "Asset Type name: " + t.Name } required/>
							</form>
						</td>
						<td>
							<input form={ fmt.Sprintf("asset-type-update-%d", t.ID) } type="number" name="sort_order" value={ fmt.Sprintf("%d", t.SortOrder) } class="input-width-70" aria-label={ "Display order: " + t.Name }/>
						</td>
						<td class="work-queue-actions">
							if vocabularyPermission(ctx, "assets", "manage") {
							<form action={ templ.URL(fmt.Sprintf("/settings/asset-types/%d/%s", t.ID, retirementAction(t.Retired))) } method="post">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline small">{ retirementLabel(t.Retired) }</button>
							</form>
							<button form={ fmt.Sprintf("asset-type-update-%d", t.ID) } type="submit" class="outline small">Save</button>
							<form action={ templ.URL(fmt.Sprintf("/settings/asset-types/%d/delete", t.ID)) } method="post" hx-confirm="Delete this type?">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline contrast small">Del</button>
							</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		if vocabularyPermission(ctx, "assets", "manage") {
		<form action="/settings/asset-types" method="post" class="inline-add-form">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			<div class="grid asset-type-add-grid">
				<input type="text" name="name" placeholder="New type name" aria-label="New Asset Type name" required/>
				<input type="number" name="sort_order" placeholder="Order" value="0" aria-label="New Asset Type display order"/>
				<button type="submit">Add</button>
			</div>
		</form>
		}
	</div>
}

templ AssetStatusList(p AssetStatusListPageData) {
	<div class="asset-statuses-list settings-panel">
		<h3>Asset Statuses</h3>
		<table class="work-queue-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Color</th>
					<th>Order</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, s := range p.Statuses {
					<tr>
						<td>
							if s.Retired {
								<small>Retired</small>
							}
							<form id={ fmt.Sprintf("asset-status-update-%d", s.ID) } action={ templ.URL(fmt.Sprintf("/settings/asset-statuses/%d", s.ID)) } method="post">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<input type="text" name="name" value={ s.Name } aria-label={ "Asset Status name: " + s.Name } required/>
							</form>
						</td>
						<td>
							<input form={ fmt.Sprintf("asset-status-update-%d", s.ID) } type="color" name="color" value={ s.Color } aria-label={ "Display color: " + s.Name }/>
						</td>
						<td>
							<input form={ fmt.Sprintf("asset-status-update-%d", s.ID) } type="number" name="sort_order" value={ fmt.Sprintf("%d", s.SortOrder) } class="input-width-70" aria-label={ "Display order: " + s.Name }/>
						</td>
						<td class="work-queue-actions">
							if vocabularyPermission(ctx, "assets", "manage") {
							<form action={ templ.URL(fmt.Sprintf("/settings/asset-statuses/%d/%s", s.ID, retirementAction(s.Retired))) } method="post">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline small">{ retirementLabel(s.Retired) }</button>
							</form>
							<button form={ fmt.Sprintf("asset-status-update-%d", s.ID) } type="submit" class="outline small">Save</button>
							<form action={ templ.URL(fmt.Sprintf("/settings/asset-statuses/%d/delete", s.ID)) } method="post" hx-confirm="Delete this status?">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline contrast small">Del</button>
							</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		if vocabularyPermission(ctx, "assets", "manage") {
		<form action="/settings/asset-statuses" method="post" class="inline-add-form">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			<div class="grid asset-status-add-grid">
				<input type="text" name="name" placeholder="New status name" aria-label="New Asset Status name" required/>
				<input type="color" name="color" value="#6B7280" aria-label="New Asset Status display color"/>
				<input type="number" name="sort_order" placeholder="Order" value="0" aria-label="New Asset Status display order"/>
				<button type="submit">Add</button>
			</div>
		</form>
		}
	</div>
}
