package templates

import "fmt"

templ CustomerShow(p CustomerShowPageData) {
	@Layout("Customer - "+p.Customer.DisplayName) {
		<div class="work-item-detail customer-dashboard">
		<p>Updated at <time datetime={ p.UpdatedAt }>{ p.UpdatedAt }</time> — successfully loaded sections. Activity is loaded separately.</p>
		<a hx-boost="false" href={ templ.URL(fmt.Sprintf("/customers/%d",p.Customer.ID)) }>Refresh dashboard</a>
		if canAllRecords(ctx,"payment.credit") || canAllRecords(ctx,"settlement.view") {
			<a href={ templ.URL(fmt.Sprintf("/customers/%d/payments",p.Customer.ID)) }>Customer receipts</a>
		}
		if canMaster(ctx,"asset.view") {
			if p.SectionErrors["Assets"] {
				@CustomerSectionUnavailable(p.Customer.ID,"Assets")
			} else {
				@CustomerAssetSections(p.Customer.ID,p.AssetPeriods)
				if p.ShowServiceEntries {
					if p.SectionErrors["Service Entries"] {
						@CustomerSectionUnavailable(p.Customer.ID,"Service Entries")
					} else {
						@CustomerAssetServiceEntries(p.AssetServiceHistory)
					}
				}
			}
		}
		if canCustomer(ctx,"edit") && p.Customer.ArchivedAt == "" {
			<a href={ templ.URL(fmt.Sprintf("/customers/%d/edit",p.Customer.ID)) } role="button">Edit Customer</a>
			if canCustomer(ctx,"financial") {
				<a href={ templ.URL(fmt.Sprintf("/customers/%d/document-defaults",p.Customer.ID)) } role="button">Document defaults</a>
			}
		}
		if p.Customer.ArchivedAt == "" && (canAllRecords(ctx,"job.create") || canAllRecords(ctx,"estimate.create") || canAllRecords(ctx,"invoice.create")) {
			<div class="work-item-detail-actions">
				<div class="work-item-detail-action-group">
					if canAllRecords(ctx,"job.create") {
						<a href={ templ.URL(fmt.Sprintf("/jobs/new?customer_id=%d", p.Customer.ID)) } role="button" aria-label={ fmt.Sprintf("Create job for %s", p.Customer.DisplayName) }>Create Job</a>
					}
					if canAllRecords(ctx,"estimate.create") {
						<a href={ templ.URL(fmt.Sprintf("/estimates/new?customer_id=%d", p.Customer.ID)) } role="button" aria-label={ fmt.Sprintf("Create estimate for %s", p.Customer.DisplayName) }>Create Estimate</a>
					}
					if canAllRecords(ctx,"invoice.create") {
						<a href={ templ.URL(fmt.Sprintf("/customers/%d/create-invoice", p.Customer.ID)) } role="button" aria-label={ fmt.Sprintf("Create invoice for %s", p.Customer.DisplayName) }>Create Invoice</a>
					}
				</div>
			</div>
		}
		if canMaster(ctx,"customer.archive") && p.Customer.ArchivedAt=="" {
			<a href={ templ.URL(fmt.Sprintf("/customers/%d/archive",p.Customer.ID)) }>Review archive</a>
		}
		if p.Customer.ArchivedAt != "" {
			<div class="work-item-detail-archive-banner">
				<span>Archived on { p.Customer.ArchivedAt }</span>
				if canMaster(ctx,"customer.restore") {
					<form action={ templ.URL(fmt.Sprintf("/customers/%d/restore", p.Customer.ID)) } method="post">
						<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
						<button type="submit" class="outline">Restore</button>
					</form>
				}
			</div>
		}
		if p.SectionErrors["Tags"] {
			@CustomerSectionUnavailable(p.Customer.ID,"Tags")
		} else {
			@TagWidget(TagWidgetData{BaseURL: fmt.Sprintf("/customers/%d", p.Customer.ID), Tags: p.Tags, AllTags: p.AllTags, ReadOnly: p.Customer.ArchivedAt != ""})
		}
		if p.SectionErrors["Custom Fields"] {
			@CustomerSectionUnavailable(p.Customer.ID,"Custom Fields")
		} else if len(p.CustomFields) > 0 {
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields})
			@FieldValuesLink("customer",p.Customer.ID,p.Customer.ArchivedAt=="")
		}
		<div class="customer-dashboard-top">
			<article class="dashboard-panel customer-dashboard-details">
				@DashboardSubcardTop("Customer Details")
				<div class="customer-details-grid">
					<div class="customer-details-main">
						<table class="work-item-detail-meta">
							<tbody>
								if p.Customer.CompanyName != "" {
									<tr><th>Company</th><td>{ p.Customer.CompanyName }</td></tr>
								}
								<tr><th>First Name</th><td>{ p.Customer.FirstName }</td></tr>
								<tr><th>Last Name</th><td>{ p.Customer.LastName }</td></tr>
								<tr><th>Email</th><td>{ p.Customer.Email }</td></tr>
								<tr><th>Phone</th><td>{ p.Customer.Phone }</td></tr>
								<tr><th>Kind</th><td>{ customerKindLabel(p.Customer.AccountType) }</td></tr>
								if canCustomer(ctx,"financial") {
									<tr><th>Billing Address</th><td>
										{ p.Customer.BillingAddress1 }<br/>
										if p.Customer.BillingAddress2 != "" {
											{ p.Customer.BillingAddress2 }<br/>
										}
										{ p.Customer.BillingCity }, { p.Customer.BillingState } { p.Customer.BillingZipCode }
									</td></tr>
									<tr><th>Tax Exempt</th><td>
										if p.Customer.TaxExempt {
											Yes
										} else {
											No
										}
									</td></tr>
								}
							</tbody>
						</table>
					</div>
					<div class="customer-details-related">
						if canMaster(ctx,"location.view") {
							<a href={ templ.URL(fmt.Sprintf("/customers/%d/locations",p.Customer.ID)) }>Manage Locations</a>
							if canMaster(ctx,"location.archived.view") {
								<a href={ templ.URL(fmt.Sprintf("/customers/%d/locations?archived=1",p.Customer.ID)) }>Archived Locations</a>
							}
							if p.SectionErrors["Locations"] {
								@CustomerSectionUnavailable(p.Customer.ID,"Locations")
							} else {
								@customerLocationsTable(p.Locations)
							}
						}
						if canMaster(ctx,"contact.view") {
							<a href={ templ.URL(fmt.Sprintf("/customers/%d/contacts",p.Customer.ID)) }>Manage Contacts</a>
							if canMaster(ctx,"contact.archived.view") {
								<a href={ templ.URL(fmt.Sprintf("/customers/%d/contacts?archived=1",p.Customer.ID)) }>Archived Contacts</a>
							}
							if p.SectionErrors["Contacts"] {
								@CustomerSectionUnavailable(p.Customer.ID,"Contacts")
							} else {
								@customerContactsTable(p.Contacts)
							}
						}
					</div>
				</div>
			</article>
			if p.ShowFinancial {
				if p.SectionErrors["Receivables"] {
					@CustomerSectionUnavailable(p.Customer.ID,"Receivables")
				} else {
					@CustomerReceivablesCard(p.Receivables)
				}
			}
		</div>
		<div class="customer-dashboard-supporting">
			<article><h3>Service Notes</h3><p>{ p.Customer.ServiceNotes }</p></article>
			@customerCommentsCard(p)
			if p.SectionErrors["Files"] {
				@CustomerSectionUnavailable(p.Customer.ID,"Files")
			} else {
				@customerFilesCard(p)
			}
		</div>
		if p.ShowCredit && p.SectionErrors["Customer Credit"] {
			@CustomerSectionUnavailable(p.Customer.ID,"Customer Credit")
		} else if p.ShowSettlement {
			@customerCredit(p)
		} else if p.ShowCredit {
			<article class="dashboard-panel"><h3>Customer Credit</h3><p>Available: { cents(p.CreditCents) }</p></article>
		}
		if canCustomerRelatedWork(ctx) {
			if p.SectionErrors["Related Work"] {
				@CustomerSectionUnavailable(p.Customer.ID,"Related Work")
			} else {
				@CustomerWorkCards(p.Customer.ID,p.RelatedWork)
			}
		}
		<div hx-get={ templ.URL(fmt.Sprintf("/customers/%d/activity", p.Customer.ID)) } hx-trigger="load" hx-swap="innerHTML">
			<p>Loading activity...</p>
		</div>
		if canCustomer(ctx, "view") {
			<p class="work-item-detail-back"><a href="/customers">&larr; Back to Customers</a></p>
		}
		</div>
	}
}

templ CustomerSectionUnavailable(id int64, title string) {
	<section aria-label={ title } role="status">
		<h3>{ title } unavailable</h3>
		<p>This section could not be loaded. No current results are shown.</p>
		<a hx-boost="false" href={ templ.URL(fmt.Sprintf("/customers/%d",id)) }>Retry { title }</a>
	</section>
}

templ customerCredit(p CustomerShowPageData) {
	<article class="dashboard-panel"><h3>Customer Credit</h3><p><strong>Available: { cents(p.Settlement.AvailableCreditCents) }</strong></p>
	if len(p.Settlement.Sources) > 0 {
		<h4>Sources</h4><div style="overflow-x: auto;"><table><thead><tr><th>Date</th><th>Origin</th><th>Original</th><th>Remaining</th></tr></thead><tbody>
		for _, s := range p.Settlement.Sources {
			<tr><td>{ s.SourceDate.Format("2006-01-02") }</td><td>
				if s.InvoiceID == 0 {
					<a href={ templ.URL(fmt.Sprintf("/customers/%d/payments",p.Customer.ID)) }>Unapplied Payment { s.SourcePaymentID.String() }</a>
				} else {
					<a href={ templ.URL(fmt.Sprintf("/invoices/%d",s.InvoiceID)) }>Payment { s.SourcePaymentID.String() }</a>
				}
				{ string(s.PaymentMethod) } { s.PaymentReference }</td><td>{ cents(s.OriginalCents) }</td><td>{ cents(s.AvailableCents) }</td></tr>
		}
		</tbody></table></div>
	}
	if len(p.Settlement.Applications) > 0 {
		<h4>Applications</h4><div style="overflow-x: auto;"><table><tbody>
		for _, a := range p.Settlement.Applications {
			<tr><td>{ a.EffectiveDate.Format("2006-01-02") }</td><td><a href={ templ.URL(fmt.Sprintf("/invoices/%d",a.InvoiceID)) }>Invoice</a></td><td>{ cents(a.AmountCents) }</td><td>
			if a.Reversal != nil {
				<span>Reversed: { a.Reversal.Reason }</span>
			}
			</td></tr>
		}
		</tbody></table></div>
	}
	if p.CanRefund && p.Customer.ArchivedAt == "" && p.Settlement.AvailableCreditCents > 0 {
		<details><summary>Refund Available Credit</summary><form action={ templ.URL(fmt.Sprintf("/customers/%d/credit/refunds",p.Customer.ID)) } method="post"><input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/><input type="hidden" name="idempotency_key" value={ p.RefundKey }/><label>Amount<input name="amount" inputmode="decimal" required/></label><label>Method<select name="method"><option value="cash">Cash</option><option value="check">Check</option><option value="credit_card">Credit Card</option><option value="transfer">Transfer</option><option value="other">Other</option></select></label><label>Date<input type="date" name="effective_date" value={ today(ctx) } required/></label><label>Reason<input name="reason" required/></label><label>Reference<input name="reference"/></label><label>Notes<input name="notes"/></label><button>Refund Credit</button></form></details>
	}
	if len(p.Settlement.Refunds) > 0 {
		<h4>Refunds</h4><div style="overflow-x: auto;"><table><tbody>
		for _, f := range p.Settlement.Refunds {
			<tr><td>{ f.EffectiveDate.Format("2006-01-02") }</td><td>{ string(f.Method) }</td><td>{ cents(f.AmountCents) }</td><td>{ f.Reason }</td><td>
			if f.Reversal != nil {
				<span>Reversed: { f.Reversal.Reason }</span>
			} else if p.CanReverseRefund && p.Customer.ArchivedAt == "" {
				<form action={ templ.URL(fmt.Sprintf("/customers/%d/credit/refunds/%s/reverse",p.Customer.ID,f.ID)) } method="post"><input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/><input type="hidden" name="idempotency_key" value={ f.ReversalKey }/><input type="date" name="effective_date" value={ today(ctx) } required/><input name="reason" placeholder="Reason" required/><button class="outline contrast">Reverse</button></form>
			}
			</td></tr>
		}
		</tbody></table></div>
	}
	</article>
}

templ customerCommentsCard(p CustomerShowPageData) {
	<article class="dashboard-panel">
			@DashboardSubcardTop("Comments")
		if p.Customer.ArchivedAt != "" {
			<div hx-get={ templ.URL(fmt.Sprintf("/customers/%d/comments?read_only=1&hide_title=1", p.Customer.ID)) } hx-trigger="load" hx-swap="innerHTML"><p>Loading comments...</p></div>
		} else {
			<div hx-get={ templ.URL(fmt.Sprintf("/customers/%d/comments?hide_title=1", p.Customer.ID)) } hx-trigger="load" hx-swap="innerHTML"><p>Loading comments...</p></div>
		}
	</article>
}

templ customerFilesCard(p CustomerShowPageData) {
	<article class="dashboard-panel">
		@DashboardSubcardTop("Files")
		<div class="files-card">
			if p.Customer.ArchivedAt == "" {
				@FileUploadWidgetWithTitle("customer", p.Customer.ID, fmt.Sprintf("/customers/%d", p.Customer.ID), false)
			}
			@FileList(p.FileList)
		</div>
	</article>
}

templ customerFinancialGraph(f CustomerFinancialSummary) {
	<div class="customer-financial-graph" aria-label={ fmt.Sprintf("Receivables: paid %.2f, current %.2f, overdue %.2f", f.TotalPaid, f.CurrentBalance, f.OverdueBalance) }>
		<div class="customer-financial-graph-title">Receivables</div>
		<div class="customer-financial-bar">
			if f.PaidPercent > 0 {
				<span class="customer-financial-paid" style={ fmt.Sprintf("width:%d%%", f.PaidPercent) }></span>
			}
			if f.OpenPercent > 0 {
				<span class="customer-financial-open" style={ fmt.Sprintf("width:%d%%", f.OpenPercent) }></span>
			}
			if f.OverduePercent > 0 {
				<span class="customer-financial-overdue" style={ fmt.Sprintf("width:%d%%", f.OverduePercent) }></span>
			}
		</div>
		<div class="customer-financial-legend">
			<span><i class="customer-financial-paid-dot"></i>Paid { fmt.Sprintf("$%.2f", f.TotalPaid) }</span>
			<span><i class="customer-financial-open-dot"></i>Current { fmt.Sprintf("$%.2f", f.CurrentBalance) }</span>
			<span><i class="customer-financial-overdue-dot"></i>Overdue { fmt.Sprintf("$%.2f", f.OverdueBalance) }</span>
		</div>
	</div>
}

templ customerLocationsTable(locations []LocationRow) {
	<section class="customer-detail-subsection">
		@DashboardSubcardTop("Locations")
		if len(locations) == 0 {
			<p class="dashboard-empty">No locations</p>
		} else {
			<table>
				<thead>
					<tr><th>Title</th><th>Address</th><th>Notes</th></tr>
				</thead>
				<tbody>
					for _, l := range locations {
						<tr>
							<td>
								{ l.Title }
								if l.IsPrimary {
									<small>Primary</small>
								}
							</td>
							<td>
								{ l.Address1 }<br/>
								if l.Address2 != "" {
									{ l.Address2 }<br/>
								}
								{ l.City }, { l.State } { l.ZipCode }
							</td>
							<td>{ l.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

templ customerContactsTable(contacts []ContactRow) {
	<section class="customer-detail-subsection">
		@DashboardSubcardTop("Contacts")
		if len(contacts) == 0 {
			<p class="dashboard-empty">No contacts</p>
		} else {
			<table>
				<thead>
					<tr><th>Name</th><th>Email</th><th>Phone</th></tr>
				</thead>
				<tbody>
					for _, c := range contacts {
						<tr><td>{ c.FirstName } { c.LastName }</td><td>{ c.Email }</td><td>{ c.Phone }</td></tr>
					}
				</tbody>
			</table>
		}
	</section>
}

templ customerJobsCard(p CustomerShowPageData) {
	<article class="dashboard-panel">
		@customerDashboardCardTop("Jobs", fmt.Sprintf("/jobs?customer_id=%d", p.Customer.ID))
		<table><tbody>
			if len(p.Jobs) == 0 {
				<tr><td class="dashboard-empty">No jobs</td></tr>
			}
			for _, j := range p.Jobs {
				<tr><td><a href={ templ.URL(fmt.Sprintf("/jobs/%d", j.ID)) }>{ j.DisplayName }</a></td><td>{ j.StatusName }</td><td><small>{ j.StartTime }</small></td></tr>
			}
		</tbody></table>
	</article>
}

templ customerEstimatesCard(p CustomerShowPageData) {
	<article class="dashboard-panel">
		@customerDashboardCardTop("Estimates", fmt.Sprintf("/estimates?customer_id=%d", p.Customer.ID))
		<table><tbody>
			if len(p.Estimates) == 0 {
				<tr><td class="dashboard-empty">No estimates</td></tr>
			}
			for _, e := range p.Estimates {
				<tr><td><a href={ templ.URL(fmt.Sprintf("/estimates/%d", e.ID)) }>{ e.Title }</a></td><td>{ e.StatusName }</td><td><small>{ e.CreatedAt }</small></td></tr>
			}
		</tbody></table>
	</article>
}

templ customerInvoicesCard(p CustomerShowPageData) {
	<article class="dashboard-panel">
		@customerDashboardCardTop("Invoices", fmt.Sprintf("/invoices?customer_id=%d", p.Customer.ID))
		<table><tbody>
			if len(p.Invoices) == 0 {
				<tr><td class="dashboard-empty">No invoices</td></tr>
			}
			for _, i := range p.Invoices {
				<tr><td><a href={ templ.URL(fmt.Sprintf("/invoices/%d", i.ID)) }>{ i.Title }</a></td><td>{ i.StatusName } / { i.SettlementState }</td><td><small>{ i.DueDate }</small></td></tr>
			}
		</tbody></table>
	</article>
}

templ customerDashboardCardTop(title string, href string) {
	<div class="dashboard-card-top dashboard-subcard-top">
		<header>{ title }</header>
		<a href={ templ.URL(href) }>View all</a>
	</div>
}
