package templates

templ HistoricalFieldReview(cycle, snapshot string) {
 @Layout("Historical pairing review") {
  <h2>Historical pairing review</h2>
  <p>Supply independently reviewed historical definition identities, types, ordered options and numeric precision. Current labels do not prove historical pairing. This records a new review; it never rewrites the original cycle or invents source values.</p>
  <details><summary>Original recorded source snapshot</summary><pre>{ snapshot }</pre></details>
  <form method="post" action={ templ.URL("/settings/custom-fields/cycles/"+cycle+"/review") } hx-boost="false">
   <input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
   <label>Historical evidence (JSON)<textarea name="evidence" rows="12" required></textarea></label>
   <p>Use field_pairs (Estimate ID to Invoice ID) and field_definitions (id, name, field_type, precision and options). Options is the historical JSON-array string. An explicitly reviewed empty pairing uses an empty object and empty definitions array.</p>
   <label>Review reason<textarea name="reason" required></textarea></label>
   <label><input type="checkbox" name="reviewed" value="true" required/> I reviewed independent historical evidence; this pairing is not inferred from current labels.</label>
   <button type="submit">Record immutable review</button>
  </form>
 }
}
