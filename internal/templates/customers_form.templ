package templates

import "fmt"

templ CustomerForm(p CustomerFormPageData) {
	@Layout(customerFormTitle(p.IsNew)) {

		if !p.IsNew {
			<div class="customer-edit-layout">
				<form action={ templ.URL(customerFormAction(p.IsNew, p.Customer.ID)) } method="post" autocomplete="off" class="entity-form compact-form customer-edit-form" data-save-status-url={ "/web-actions/"+p.OperationID }>
					@CustomerFormFields(p)
				</form>
				<aside class="customer-edit-side-rail">
					<article class="dashboard-panel">
						@DashboardSubcardTop("Locations")
						@LocationsListCompact(p.Locations, p.Customer.ID, !canManageOperational(ctx))
					</article>
					<article class="dashboard-panel">
						@DashboardSubcardTop("Contacts")
						@ContactsListCompact(p.Contacts, p.Customer.ID, !canManageOperational(ctx))
					</article>
					<article class="dashboard-panel">
						@DashboardSubcardTop("Tags")
						@TagWidget(TagWidgetData{BaseURL: fmt.Sprintf("/customers/%d", p.Customer.ID), Tags: p.Tags, AllTags: p.AllTags, ReadOnly: !canManageOperational(ctx)})
					</article>
				</aside>
			</div>
		} else {
			<form action={ templ.URL(customerFormAction(p.IsNew, p.Customer.ID)) } method="post" autocomplete="off" class="entity-form compact-form" data-save-status-url={ "/web-actions/"+p.OperationID }>
				@CustomerFormFields(p)
			</form>
		}
	}
}

templ CustomerFormFields(p CustomerFormPageData) {
	<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
	<input type="hidden" name="operation_id" value={ p.OperationID }/>
	<input type="hidden" name="revision" value={ p.Revision }/>
	if p.Conflict != nil {
		<section class="error-summary" aria-label="Current saved Customer">
			<h2>Conflict: compare with the current saved Customer</h2>
			<p>Your proposed values remain in the form below. Review the current record before saving a revised action.</p>
			<dl>
				<dt>Display name</dt><dd>{ p.Conflict.DisplayName }</dd>
				<dt>Name</dt><dd>{ p.Conflict.FirstName + " " + p.Conflict.LastName }</dd>
				<dt>Company</dt><dd>{ p.Conflict.CompanyName }</dd>
				<dt>Email</dt><dd>{ p.Conflict.Email }</dd>
				<dt>Phone</dt><dd>{ p.Conflict.Phone }</dd>
				<dt>Notes</dt><dd>{ p.Conflict.Notes }</dd>
				<dt>Service notes</dt><dd>{ p.Conflict.ServiceNotes }</dd>
				<dt>Status</dt><dd>{ p.Conflict.Status }</dd>
				<dt>Account type</dt><dd>{ p.Conflict.AccountType }</dd>
				if canCustomer(ctx,"financial") {
					<dt>Billing address</dt><dd>{ p.Conflict.BillingAddress1 }<br/>{ p.Conflict.BillingAddress2 }<br/>{ p.Conflict.BillingCity + " " + p.Conflict.BillingState + " " + p.Conflict.BillingZipCode }</dd>
					<dt>Tax exempt</dt><dd>{ fmt.Sprint(p.Conflict.TaxExempt) }</dd>
				}
			</dl>
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields:p.ConflictFields,EditMode:false})
			<label><input type="checkbox" name="conflict_review" required/>I have compared the current record and reviewed my proposed changes.</label>
			<a href={ templ.URL(fmt.Sprintf("/customers/%d/edit",p.Customer.ID)) }>Discard changes and load current Customer</a>
		</section>
	}
	if p.IsNew {
		<p><small>Locations and contacts can be added after saving.</small></p>
	}
	<fieldset>
		<legend>Customer Info</legend>
		<label>
			First Name
			<input type="text" name="first_name" value={ p.Customer.FirstName }/>
			if p.Errors["first_name"] != "" {
				<small class="error-msg">{ p.Errors["first_name"] }</small>
			}
		</label>
		<label>
			Last Name
			<input type="text" name="last_name" value={ p.Customer.LastName }/>
		</label>
		<label>
			Display Name
			<input type="text" name="display_name" value={ p.Customer.DisplayName }/>
			if p.Errors["display_name"] != "" {
				<small class="error-msg">{ p.Errors["display_name"] }</small>
			}
		</label>
		<div class="grid">
			<label>
					Email
					<input type="email" name="email" value={ p.Customer.Email }/>
				</label>
			<label>
				Phone
				<input type="tel" name="phone" value={ p.Customer.Phone }/>
			</label>
		</div>
		<label>
			Company
			<input type="text" name="company_name" value={ p.Customer.CompanyName }/>
		</label>
		<div class="grid">
			<label>
				Status
				<select name="status">
					for _, s := range p.Statuses {
						<option value={ s } selected?={ p.Customer.Status == s }>{ s }</option>
					}
				</select>
			</label>
			<label>
				Account Type
				<select name="account_type">
					for _, a := range p.AccountTypes {
						<option value={ a } selected?={ p.Customer.AccountType == a }>{ a }</option>
					}
				</select>
			</label>
		</div>
		<label>
				Notes
				<textarea name="notes" rows="3">{ p.Customer.Notes }</textarea>
			</label>
		@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields, EditMode: true})
		<label>Service Notes (shared with assigned Job context)
			<textarea name="service_notes" rows="3">{ p.Customer.ServiceNotes }</textarea>
		</label>
	</fieldset>
	if canCustomer(ctx,"financial") {
	<fieldset>
		<legend>Billing Address</legend>
		<label>
			Address Line 1
			<input type="text" name="billing_address_1" value={ p.Customer.BillingAddress1 }/>
		</label>
		<label>
			Address Line 2
			<input type="text" name="billing_address_2" value={ p.Customer.BillingAddress2 }/>
		</label>
		<div class="grid form-grid-address">
			<label>
				City
				<input type="text" name="billing_city" value={ p.Customer.BillingCity }/>
			</label>
			<label>
				State
				<input type="text" name="billing_state" value={ p.Customer.BillingState }/>
			</label>
			<label>
				ZIP
				<input type="text" name="billing_zip_code" value={ p.Customer.BillingZipCode }/>
			</label>
		</div>
		<label>
			<input type="checkbox" name="tax_exempt" value="true" checked?={ p.Customer.TaxExempt }/>
			<input type="hidden" name="tax_exempt_present" value="1"/>
			Tax exempt
		</label>
	</fieldset>
	}
	<div class="entity-form-actions">
		<button type="submit">{ customerFormSubmitLabel(p.IsNew) }</button>
		<a href="/customers" role="button" class="outline">Cancel</a>
	</div>
}

func customerFormSubmitLabel(isNew bool) string {
	if isNew {
		return "Save and continue"
	}
	return "Save"
}
