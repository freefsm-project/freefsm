package templates

import "fmt"

templ CustomFieldDefIndex(p CustomFieldDefListPageData) {
	@Layout("Custom Fields") {
		<div class="work-queue-toolbar list-toolbar">
			<h2>Custom Fields</h2>
			if canManageFieldDefinitions(ctx) {
				<a href="/settings/custom-fields/new" role="button">New Field</a>
			}
		</div>
		<div class="work-queue-wrap">
		<table class="work-queue-table">
			<thead>
				<tr><th>Name</th><th>Entity</th><th>Type</th><th>Conversion Pair</th><th>Required</th><th>Order</th><th></th></tr>
			</thead>
			<tbody>
				if len(p.Definitions) == 0 {
					<tr><td colspan="7">No custom fields defined yet.</td></tr>
				} else {
					for _, d := range p.Definitions {
						<tr>
							<td><strong>{ d.Name }</strong></td>
							<td>{ d.ObjectType }</td>
							<td>{ d.FieldType }</td>
							<td>
								{ d.ConversionKey }
								if d.ConversionKey != "" {
									<small>{ d.Counterpart }</small>
								}
							</td>
							<td>
								if d.Required {
									Yes
								} else {
									No
								}
							</td>
							<td>{ fmt.Sprintf("%d", d.SortOrder) }</td>
							<td class="work-queue-actions">
								if canManageFieldDefinitions(ctx) {
								<a href={ templ.URL(fmt.Sprintf("/settings/custom-fields/%d/edit", d.ID)) } role="button" class="outline compact-action-button">Edit</a>
								<form action={ templ.URL(fmt.Sprintf("/settings/custom-fields/%d/delete", d.ID)) } method="post" hx-confirm="Delete this custom field? This cannot be undone.">
									<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
									<button class="outline contrast compact-action-button">Delete</button>
								</form>
								}
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
		</div>
		<p class="work-item-detail-back"><a href="/settings">&larr; Back to Settings</a></p>
		if canAdmin(ctx) {
			<div hx-get="/settings/custom-fields/activity" hx-trigger="load" hx-swap="innerHTML" class="shared-widget">
				<p>Loading recent activity...</p>
			</div>
		}
	}
}

templ CustomFieldDefForm(p CustomFieldDefFormData) {
	@Layout("Custom Field - " + formTitle(p)) {
		<form action={ templ.URL(customFieldDefFormAction(p)) } method="post" hx-boost="false" autocomplete="off" class="entity-form compact-form">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			if p.Errors["definition"] != "" {
				<p role="alert" class="error-msg">{ p.Errors["definition"] }</p>
			}
			if !p.IsNew {
				<input type="hidden" name="id" value={ fmt.Sprintf("%d", p.Def.ID) }/>
				<input type="hidden" name="object_type" value={ p.Def.ObjectType }/>
			}
			<label>
				Name
				<input type="text" name="name" value={ p.Def.Name }/>
				if p.Errors["name"] != "" {
					<small class="error-msg">{ p.Errors["name"] }</small>
				}
			</label>
			<div class="grid">
				<label>
					Entity Type
					<select name="object_type" disabled?={ !p.IsNew }>
						for _, ot := range p.ObjectTypes {
							<option value={ ot } selected?={ p.Def.ObjectType == ot }>{ ot }</option>
						}
					</select>
				</label>
				<label>
					Field Type
					<select name="field_type">
						for _, ft := range p.FieldTypes {
							<option value={ ft } selected?={ p.Def.FieldType == ft }>{ ft }</option>
						}
					</select>
				</label>
			</div>
			<div class="grid">
				<label>
					Required
					<select name="required">
						<option value="false" selected?={ !p.Def.Required }>No</option>
						<option value="true" selected?={ p.Def.Required }>Yes</option>
					</select>
				</label>
				<label>
					Sort Order
					<input type="number" name="sort_order" value={ fmt.Sprintf("%d", p.Def.SortOrder) } min="0"/>
				</label>
			</div>
			<label>
				Options (JSON array, for single-select and multiselect)
				<input type="text" name="options" value={ p.Def.Options } placeholder='["Option 1","Option 2"]'/>
				<small>Unique option text identifies each choice within this field. Referenced choices cannot be removed.</small>
			</label>
			<label>
				Number decimal precision (0–18)
				<input type="number" name="precision" min="0" max="18" value={ fieldPrecision(p.Def.Precision) }/>
			</label>
			<label>
				Creation default (optional)
				<textarea name="default_value" rows="2">{ p.Def.DefaultValue }</textarea>
				<small>Used only for new records when input is omitted. Existing records are never backfilled. Checkbox: true or false. Multiselect: a JSON array of option texts.</small>
			</label>
			if p.Def.ObjectType == "estimate" || p.Def.ObjectType == "invoice" || p.IsNew {
				<label>
					Conversion Key (optional)
					<input type="text" name="conversion_key" value={ p.Def.ConversionKey } pattern="[A-Za-z0-9][A-Za-z0-9_-]*"/>
					<small>Only paired Estimate and Invoice fields with the same key, type, and compatible options transfer during conversion and revert.</small>
					if p.Errors["conversion_key"] != "" {
						<small class="error-msg">{ p.Errors["conversion_key"] }</small>
					}
				</label>
			}
			<div class="entity-form-actions">
				<button type="submit">Save</button>
				<a href="/settings/custom-fields" role="button" class="outline">Cancel</a>
			</div>
		</form>
	}
}

func formTitle(p CustomFieldDefFormData) string {
	if p.IsNew {
		return "New Field"
	}
	return "Edit " + p.Def.Name
}

func fieldPrecision(v *int) string {if v==nil{return ""};return fmt.Sprint(*v)}

func customFieldDefFormAction(p CustomFieldDefFormData) string {
	if p.IsNew { return "/settings/custom-fields" }
	return fmt.Sprintf("/settings/custom-fields/%d", p.Def.ID)
}
