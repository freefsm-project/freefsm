package templates

import "fmt"

type LineItemEditorData struct {
	AdjustmentsJSON string
	Financial string
	ExistingDocument bool
	JobPricing        bool
	ItemsJSON         string
	ExistingItemsJSON string
	CustomersJSON     string
}

templ LineItemEditor(p LineItemEditorData) {
	<script src="/static/js/commercial-arithmetic.js"></script>
	<script>
		function lineItemEditor(root) {
			const readJSON = (name, fallback) => JSON.parse(root.querySelector(`[data-line-item-json="${name}"]`).textContent || fallback);
			const catalog = readJSON('catalog', '[]');
			const existing = readJSON('existing', '[]');
			const taxContext = readJSON('customers', '{"default_tax_rate":"0","customers":{}}');
			const financial = readJSON('financial', '{}');
			const documentAdjustments = readJSON('adjustments', 'null') || financial.input || {};
			const form = root.closest('form');
			const noAdjustment = root.dataset.jobPricing === 'true' ? 0 : '';
			const makeItem = () => ({ item_id: 0, title: '', description: form.querySelector('[name="default_line_description"]')?.value || '', unit_price: 0, quantity: 1, taxable: false, tax_rate: '', discount: noAdjustment, surcharge: noAdjustment });
			const makeNewItem = () => ({ name: '', type: 'product', sku: '', description: '', unit_price: 0, taxable: true, tax_rate: '', track_inventory: false });
			const parseRate = (value) => (parseFloat(String(value || '').replace('%', '').trim()) || 0) / 100;
			const roundMoney = (value) => Math.sign(value) * Math.round((Math.abs(value) + Number.EPSILON) * 100) / 100;
			existing.forEach((item) => {
				if (item.quantity === null || item.quantity === undefined || item.quantity === '') item.quantity = 1;
				item.item_id = Number(item.item_id) || 0;
				if (root.dataset.jobPricing !== 'true') {
					item.unit_price = item.unit_price_decimal || String(item.unit_price);
					item.quantity = item.quantity_decimal || String(item.quantity);
					for (const name of ['discount','surcharge']) {
						item[name+'_kind'] = item[name+'_adjustment']?.kind || 'fixed';
						if (item[name+'_adjustment']) item[name] = item[name+'_adjustment'].value;
						else if (Number(item[name] || 0) === 0) item[name] = '';
					}
				}
			});
			return {
				items: existing.length ? existing : [makeItem()],
				documentDiscount: documentAdjustments.discount?.value ?? '',
				documentDiscountKind: documentAdjustments.discount?.kind || 'fixed',
				documentSurcharge: documentAdjustments.surcharge?.value ?? '',
				documentSurchargeKind: documentAdjustments.surcharge?.kind || 'fixed',
				baseline: '',
				effectiveTaxKey: '',
				effectiveTaxRate: '',
				taxRequest: 0,
				taxPreviewError: '',
				catalog,
				newItem: makeNewItem(),
				creatingItem: false,
				createItemError: '',
				wasTaxExempt: Boolean(financial.input?.tax_exempt),
				lastNonExemptTaxRate: taxContext.default_tax_rate || '0',
				taxVersion: 0,
				init() {
					const customerSelect = form.querySelector('select[name="customer_id"]');
					const taxInput = form.querySelector('input[name="tax_rate"]');
					if (customerSelect) customerSelect.addEventListener('change', () => { this.syncCustomerTax(); this.refreshTax(); });
					if (taxInput) taxInput.addEventListener('input', () => { this.taxVersion++; this.refreshTax(); });
					const jobSelect=form.querySelector('select[name="job_id"]');
					if(jobSelect)jobSelect.addEventListener('change',()=>{this.taxVersion++;this.refreshTax();});
					if (root.dataset.existingDocument !== 'true') this.syncCustomerTax();
					this.baseline = this.moneySignature();
					this.refreshTax();
				},
				add() { this.items.push(makeItem()); },
				addOnEnter(event) {
					if (!event.target.matches('input[type="text"], input[type="number"]')) return;
					// Enter may confirm an IME candidate rather than finish a line.
					if (event.isComposing || event.keyCode === 229) return;
					event.preventDefault();
					if (event.repeat) return;
					this.add();
					this.$nextTick(() => this.$refs.lineRows.querySelector('tr:last-child input[type="text"]').focus());
				},
				remove(index) { this.items.splice(index, 1); },
				applyCatalogItem(item, catalogItem) {
					item.item_id = Number(catalogItem.id) || 0;
					item.title = catalogItem.name;
					item.description = catalogItem.description || '';
					item.unit_price = Number(catalogItem.unit_price) || 0;
					item.taxable = Boolean(catalogItem.taxable);
					item.tax_rate = catalogItem.tax_rate || '';
				},
				selectItem(index, itemID) {
					this.items[index].item_id = Number(itemID) || 0;
					const catalogItem = this.catalog.find((candidate) => candidate.id == itemID);
					if (catalogItem) this.applyCatalogItem(this.items[index], catalogItem);
				},
				openCreateItemModal() {
					this.createItemError = '';
					if (this.$refs.createItemDialog && !this.$refs.createItemDialog.open) this.$refs.createItemDialog.showModal();
				},
				closeCreateItemModal() {
					if (this.$refs.createItemDialog && this.$refs.createItemDialog.open) this.$refs.createItemDialog.close();
				},
				documentTaxRate() {
					this.taxVersion;
					const taxInput = form.querySelector('input[name="tax_rate"]');
					return parseRate(taxInput ? taxInput.value : taxContext.default_tax_rate);
				},
				syncCustomerTax() {
					const customerSelect = form.querySelector('select[name="customer_id"]');
					const taxInput = form.querySelector('input[name="tax_rate"]');
					if (!customerSelect || !taxInput) return;
					this.taxVersion++;
					const info = taxContext.customers[String(customerSelect.value)] || {};
					if (info.tax_exempt) {
						if (!this.wasTaxExempt && parseRate(taxInput.value) > 0) this.lastNonExemptTaxRate = taxInput.value;
						taxInput.value = '0';
						this.wasTaxExempt = true;
						this.taxVersion++;
						return;
					}
					if (this.wasTaxExempt && parseRate(taxInput.value) <= 0) taxInput.value = this.lastNonExemptTaxRate || taxContext.default_tax_rate || '0';
					if (!this.wasTaxExempt && !taxInput.value) taxInput.value = taxContext.default_tax_rate || '0';
					this.wasTaxExempt = false;
					this.taxVersion++;
				},
				async createItem() {
					this.createItemError = '';
					if (!this.newItem.name.trim()) { this.createItemError = 'Item name is required.'; return; }
					this.creatingItem = true;
					try {
						const body = new URLSearchParams();
						['name', 'type', 'sku', 'description', 'unit_price', 'tax_rate'].forEach((name) => body.set(name, this.newItem[name] ?? ''));
						body.set('taxable', this.newItem.taxable ? 'true' : 'false');
						body.set('track_inventory', this.newItem.track_inventory ? 'true' : 'false');
						const csrf = document.querySelector('meta[name="csrf-token"]');
						const response = await window.freefsmActions.fetch('/items/inline', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf ? csrf.content : '' }, body }, this.$refs.createItemDialog);
						if (!response.ok) throw new Error((await response.text()) || 'Unable to create item.');
						const created = await response.json();
						this.catalog.push(created);
						const item = makeItem();
						this.applyCatalogItem(item, created);
						this.items.push(item);
						this.newItem = makeNewItem();
						this.closeCreateItemModal();
					} catch (error) {
						this.createItemError = error.message || 'Unable to create item.';
					} finally { this.creatingItem = false; }
				},
				lineTotal(item) { return roundMoney((Number(item.unit_price) * Number(item.quantity)) - Number(item.discount || 0) + Number(item.surcharge || 0)); },
				get subtotal() { return roundMoney(this.items.reduce((sum, item) => sum + this.lineTotal(item), 0)); },
				get tax() { if (root.dataset.jobPricing === 'true') return roundMoney(this.items.reduce((sum,item) => sum + (item.taxable ? roundMoney(this.lineTotal(item) * parseRate(item.tax_rate)) : 0), 0)); return roundMoney(this.items.reduce((sum, item) => item.taxable ? sum + this.lineTotal(item) : sum, 0) * this.documentTaxRate()); },
				get total() { return roundMoney(this.subtotal + this.tax); },
				adjustment(kind,value) { if (value === '') return undefined; return {kind:kind||'fixed',value:kind==='percentage'?String(value):this.moneyText(value)}; },
				moneyText(value) { try {return window.freefsmCommercial.moneyText(value);} catch (_) {return String(value);} },
				taxSelection() {this.taxVersion;return {customer_id:form.querySelector('[name="customer_id"]')?.value||'0',job_id:form.querySelector('[name="job_id"]')?.value||'0',rate:form.querySelector('[name="tax_rate"]')?.value||'0'};},
				taxKey() {return JSON.stringify(this.taxSelection());},
				async refreshTax() {
					if(root.dataset.jobPricing==='true')return;
					const selection=this.taxSelection(),key=JSON.stringify(selection),request=++this.taxRequest;
					this.taxPreviewError='';
					if(!Number(selection.customer_id)){this.effectiveTaxKey=key;this.effectiveTaxRate=selection.rate;return;}
					try {
						const response=await fetch('/commercial/tax-preview?'+new URLSearchParams(selection),{cache:'no-store'});
						if(!response.ok)throw new Error('Tax preview unavailable. Check access and tax rate, then refresh.');
						const data=await response.json();
						if(request!==this.taxRequest||key!==this.taxKey())return;
						this.effectiveTaxRate=data.rate;this.effectiveTaxKey=key;
					} catch(error) {if(request===this.taxRequest){this.effectiveTaxKey='';this.taxPreviewError='Tax preview unavailable. Check access and tax rate, then refresh.';}}
				},
				get adjustmentsJSON() { return JSON.stringify({discount:this.adjustment(this.documentDiscountKind,this.documentDiscount),surcharge:this.adjustment(this.documentSurchargeKind,this.documentSurcharge)}); },
				exactInput() {
					this.taxVersion;
					const customer = form.querySelector('[name="customer_id"]');
					const exempt = taxContext.customers[String(customer?.value)]?.tax_exempt || false;
					return {...JSON.parse(this.adjustmentsJSON),tax_rate:String(form.querySelector('[name="tax_rate"]')?.value || '0').replace('%','').trim(),tax_exempt:exempt,
						lines:this.items.filter(item=>item.item_id>0||item.title).map(item=>({quantity:String(item.quantity),unit_price:this.moneyText(item.unit_price),taxable:Boolean(item.taxable),discount:this.adjustment(item.discount_kind,item.discount),surcharge:this.adjustment(item.surcharge_kind,item.surcharge)}))};
				},
				moneySignature() { return JSON.stringify({customer_id:form.querySelector('[name="customer_id"]')?.value || '',input:window.freefsmCommercial.signature(this.exactInput())}); },
				get preview() {
					if(root.dataset.jobPricing==='true') return null;
					if(root.dataset.existingDocument==='true' && this.baseline===this.moneySignature()) return financial.result || {error:'Recorded totals unavailable. Review the financial inputs before saving monetary changes.'};
					if(this.effectiveTaxKey!==this.taxKey())return {error:this.taxPreviewError||'Checking tax preview…'};
					try {const input=this.exactInput();input.tax_rate=String(this.effectiveTaxRate).replace('%','').trim();input.tax_exempt=false;return window.freefsmCommercial.calculate(input);} catch(error) {return {error:error.message};}
				},
				get previewError() { return this.preview?.error || ''; },
				lineDisplay(item,index) { const p=this.preview; if(p?.error)return 'Invalid'; if(p?.lines[index])return window.freefsmCommercial.format(p.lines[index].adjusted_cents); return this.lineTotal(item).toFixed(2); },
				totalDisplay(part) { const p=this.preview;if(p?.error)return 'Invalid';if(p)return window.freefsmCommercial.format(p[part]);return (part==='pretax_cents'?this.subtotal:part==='tax_cents'?this.tax:this.total).toFixed(2); },
				get json() { return JSON.stringify(this.items.filter((item) => item.item_id > 0 || item.title).map((item) => ({ ...(item.snapshot_id ? {snapshot_id: item.snapshot_id} : {}), item_id: Number(item.item_id) || 0, title: item.title, description: item.description, unit_price: Number(item.unit_price) || 0, quantity: Number(item.quantity), taxable: Boolean(item.taxable), tax_rate: item.tax_rate || '', ...(root.dataset.jobPricing==='true'?{discount:Number(item.discount)||0,surcharge:Number(item.surcharge)||0}:{unit_price_decimal:this.moneyText(item.unit_price),quantity_decimal:String(item.quantity),discount_adjustment:this.adjustment(item.discount_kind,item.discount),surcharge_adjustment:this.adjustment(item.surcharge_kind,item.surcharge)}) }))); },
			};
		}
	</script>
	<fieldset x-data="lineItemEditor($el)" data-line-item-editor data-job-pricing={ fmt.Sprint(p.JobPricing) } data-existing-document={ fmt.Sprint(p.ExistingDocument) }>
		@templ.Raw(`<script type="application/json" data-line-item-json="financial">` + p.Financial + `</script>`)
		@templ.Raw(`<script type="application/json" data-line-item-json="adjustments">` + p.AdjustmentsJSON + `</script>`)
		@templ.Raw(`<script type="application/json" data-line-item-json="catalog">` + p.ItemsJSON + `</script>`)
		@templ.Raw(`<script type="application/json" data-line-item-json="existing">` + p.ExistingItemsJSON + `</script>`)
		@templ.Raw(`<script type="application/json" data-line-item-json="customers">` + p.CustomersJSON + `</script>`)
		<legend>Line Items</legend>
		if !p.JobPricing {
			<small>Leave adjustment fields blank for no adjustment. An entered zero is retained as an explicit adjustment.</small>
		}
		<div class="table-scroll line-items-scroll" role="region" aria-label="Line items, scroll for more columns" tabindex="0"><table>
			<thead><tr><th>Catalog</th><th>Title</th><th>Description</th><th>Qty</th><th>Price</th><th>Discount</th><th>Surcharge</th><th>Taxable</th>
				if p.JobPricing {
					<th>Captured tax rate (%)</th>
				}
				<th>Total</th><th></th></tr></thead>
			<tbody x-ref="lineRows" @keydown.enter="addOnEnter($event)">
				<template x-for="(item, index) in items" :key="index">
					<tr>
						<td>
							if p.JobPricing {
								<template x-if="item.snapshot_id"><span x-text="item.item_id ? 'Captured Item #' + item.item_id : 'Free-text capture'"></span></template>
							}
							<select aria-label="Catalog item" x-model.number="item.item_id" x-init="$nextTick(() => { $el.value = String(item.item_id || 0) })" @change="selectItem(index, $el.value)" :disabled={ fmt.Sprintf("%t && !!item.snapshot_id", p.JobPricing) }><option value="0">Free-text line</option><template x-for="catalogItem in catalog" :key="catalogItem.id"><option :value="catalogItem.id" :selected="Number(catalogItem.id) === Number(item.item_id)" x-text="catalogItem.name"></option></template></select>
						</td>
						<td><input type="text" x-model="item.title" placeholder="Line title" aria-label="Line item title"/></td>
						<td><textarea x-model="item.description" rows="2" placeholder="Line item description" aria-label="Line item description"></textarea></td>
						<td><input type={ commercialInputType(p.JobPricing) } inputmode="decimal" x-model="item.quantity" step="any" min="0" class="input-width-70" aria-label="Quantity"/></td>
						<td><input type={ commercialInputType(p.JobPricing) } inputmode="decimal" x-model="item.unit_price" step="0.01" class="input-width-100" aria-label="Unit price"/></td>
						<td><input type={ commercialInputType(p.JobPricing) } inputmode="decimal" x-model="item.discount" step="any" min="0" class="input-width-100" aria-label="Discount"/>
							if !p.JobPricing {
								<select x-model="item.discount_kind" aria-label="Discount kind"><option value="fixed">USD</option><option value="percentage">%</option></select>
							}
						</td>
						<td><input type={ commercialInputType(p.JobPricing) } inputmode="decimal" x-model="item.surcharge" step="any" min="0" class="input-width-100" aria-label="Surcharge"/>
							if !p.JobPricing {
								<select x-model="item.surcharge_kind" aria-label="Surcharge kind"><option value="fixed">USD</option><option value="percentage">%</option></select>
							}
						</td>
						<td><input type="checkbox" x-model="item.taxable" aria-label="Taxable line item"/></td>
						if p.JobPricing {
							<td><input type="text" inputmode="decimal" x-model="item.tax_rate" aria-label="Captured tax rate"/></td>
						}
						<td><span x-text="lineDisplay(item,index)"></span></td>
						<td><button type="button" @click.prevent="remove(index)" class="outline contrast small" aria-label="Remove line item">X</button></td>
					</tr>
				</template>
			</tbody>
		</table></div>
		<div class="line-item-actions">
			<button type="button" @click.prevent="add()" class="outline">Add Line</button>
			if itemPermission(ctx, "item.create") && itemPermission(ctx, "pricebook.create") {
				<button type="button" @click.prevent="openCreateItemModal()" class="outline">Create Item</button>
			}
		</div>
		if itemPermission(ctx, "item.create") && itemPermission(ctx, "pricebook.create") {
			<dialog class="item-create-dialog" x-ref="createItemDialog" @click.self="closeCreateItemModal()">
				<article class="item-create-dialog-card">
					<header class="item-create-dialog-header"><strong>Create Item</strong><button type="button" class="outline small" @click="closeCreateItemModal()">Close</button></header>
					<div class="item-create-dialog-body">
						<label>Name <small class="required-marker">*</small><input type="text" x-model="newItem.name" placeholder="Item name"/></label>
						<div class="grid"><label>Type<select x-model="newItem.type"><option value="product">product</option><option value="service">service</option></select></label><label>SKU<input type="text" x-model="newItem.sku" placeholder="Optional"/></label></div>
						<label>Unit Price<input type="number" x-model="newItem.unit_price" step="0.01" min="0"/></label>
						<div class="grid"><label><input type="checkbox" x-model="newItem.taxable"/> Taxable</label><label>Tax Rate<input type="text" x-model="newItem.tax_rate" placeholder="e.g. 8.25%"/></label></div>
						<label><input type="checkbox" x-model="newItem.track_inventory"/> Track Inventory</label>
						<label>Description<textarea x-model="newItem.description" rows="3"></textarea></label>
						<small class="error-msg" x-text="createItemError" x-show="createItemError"></small>
					</div>
					<footer class="item-create-dialog-actions"><button type="button" @click="createItem()" :aria-busy="creatingItem" x-text="creatingItem ? 'Creating...' : 'Create Item'"></button><button type="button" class="outline" @click="closeCreateItemModal()">Cancel</button></footer>
				</article>
			</dialog>
		}
		if !p.JobPricing {
			<div class="grid">
				<label>Document discount<input type="text" inputmode="decimal" x-model="documentDiscount" aria-label="Document discount"/><select x-model="documentDiscountKind" aria-label="Document discount kind"><option value="fixed">USD</option><option value="percentage">%</option></select></label>
				<label>Document surcharge<input type="text" inputmode="decimal" x-model="documentSurcharge" aria-label="Document surcharge"/><select x-model="documentSurchargeKind" aria-label="Document surcharge kind"><option value="fixed">USD</option><option value="percentage">%</option></select></label>
			</div>
			<input type="hidden" name="adjustments" :value="adjustmentsJSON"/>
			<p role="status" x-text="previewError"></p>
			<button type="button" class="outline" x-show="taxPreviewError" @click="refreshTax()">Refresh tax preview</button>
		}
		<div class="line-item-totals"><p>Subtotal: $<span x-text="totalDisplay('pretax_cents')"></span></p><p>Tax: $<span x-text="totalDisplay('tax_cents')"></span></p><p><strong>Total: $<span x-text="totalDisplay('total_cents')"></span></strong></p></div>
		<input type="hidden" name="line_items" :value="json"/>
	</fieldset>
}
