package templates

import "fmt"

templ ResetPasswordPage(p ResetPasswordData) {
	@Layout("Reset Password") {
		<article class="auth-card">
			<hgroup>
				<h2>Reset Password</h2>
				<p>Enter your new password</p>
			</hgroup>
			if p.Error != "" {
				<div class="error-msg">{ p.Error }</div>
			}
			if p.Valid {
				<form action="/reset-password" method="post" hx-boost="false">
					<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
					<input type="hidden" name="token" value={ p.Token }/>
					@NewPasswordFields(NewPasswordFieldsOptions{
						ID: "reset-password", Name: "password", Label: "New Password", Placeholder: "New password",
						ConfirmID: "reset-confirm-password", ConfirmLabel: "Confirm New Password", ConfirmPlaceholder: "Confirm new password",
						Autocomplete: "new-password", MinLength: recoveryMinLength(p), Required: true, Autofocus: true,
					})
					if p.Policy != nil {
						<p>At least { fmt.Sprint(p.Policy.PasswordMinLength) } characters (UTF-16 length); at most 72 UTF-8 bytes.</p>
						if p.Policy.PasswordRequireUppercase {
							<p>One uppercase letter (A–Z)</p>
						}
						if p.Policy.PasswordRequireLowercase {
							<p>One lowercase letter (a–z)</p>
						}
						if p.Policy.PasswordRequireDigit {
							<p>One digit (0–9)</p>
						}
						if p.Policy.PasswordRequireSpecial {
							<p>One special character (outside A–Z, a–z, 0–9)</p>
						}
					}
					<button type="submit">Reset Password</button>
				</form>
			}
			<p class="auth-link"><a href="/login">&larr; Back to Login</a></p>
		</article>
	}
}

func recoveryMinLength(p ResetPasswordData) int {
 if p.Policy != nil { return p.Policy.PasswordMinLength }
 return 8
}
