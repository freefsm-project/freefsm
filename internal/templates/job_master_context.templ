package templates
import "github.com/freefsm-project/freefsm/internal/authorization"
import "fmt"

templ JobMasterContext(p authorization.JobMasterContext) {
	<section aria-label="Linked Job context">
		if p.ProjectReference != nil {
			<h3>Linked Project</h3>
			<p>{ p.ProjectReference.Name } <span class="badge">Archived</span></p>
		}
		if p.Project != nil {
			if p.ProjectReference == nil {
				<h3>Linked Project</h3>
				<p>{ p.Project.Name }</p>
			}
			<p>{ p.Project.Description }</p>
			<p>{ p.Project.Status } — { fmt.Sprintf("%.0f%%",p.Project.Progress) }</p>
			if p.Project.PlannedStartDate != nil {
				<p>Planned start: { *p.Project.PlannedStartDate }</p>
			}
			if p.Project.PlannedEndDate != nil {
				<p>Planned end: { *p.Project.PlannedEndDate }</p>
			}
			<p>{ p.Project.Location }
				if p.Project.LocationArchived {
					<mark>Archived</mark>
				}
			</p><p>{ p.Project.ServiceNotes }</p>
		}
		for _, equipment := range p.Assets {
			<h3>Operational Asset</h3>
			<p>{ equipment.Number } · { equipment.Name } · { assetOwnershipLabel(equipment.OwnershipClass) }</p>
			<p>{ equipment.Type } · { equipment.Status }</p>
			<p>{ equipment.Manufacturer } { equipment.Model } · { equipment.SerialNumber }</p>
			if equipment.InstalledAt != nil {
				<p>Installed: { displayDatePtr(ctx,equipment.InstalledAt) }</p>
			}
			if equipment.WarrantyExpires != nil {
				<p>Warranty: { displayDatePtr(ctx,equipment.WarrantyExpires) }</p>
			}
			if equipment.Location != nil {
				<p>Current Location: { equipment.Location.Title }
					if equipment.Location.Archived {
						<mark>Archived</mark>
					}
				</p>
			}
			<p>{ equipment.ServiceNotes }</p>
			if equipment.ServiceEntryPath!="" {
				<a href={templ.URL(equipment.ServiceEntryPath)}>Service Entries</a>
			}
			if len(equipment.ServiceEntries)>0 {
				<h3>Service history for this Customer</h3>
				@ServiceEntryHistory(equipment.ServiceEntries)
			}
		}
		for _, contact := range p.Contacts {
			<h3>Linked Contact</h3><p>{ contact.Name } { contact.RoleTitle }</p><p>{ contact.Phone } { contact.Email }</p><p>{ contact.ServiceNotes }</p>
		}
		if p.Location != nil {
			<h3>Linked Location</h3><p>{ p.Location.Title }</p><p>{ p.Location.Address1 } { p.Location.Address2 } { p.Location.City } { p.Location.State } { p.Location.ZipCode }</p><p>{ p.Location.AccessNotes }</p><p>{ p.Location.ServiceNotes }</p>
			if p.Location.Latitude != nil && p.Location.Longitude != nil {
				<p>Coordinates: { fmt.Sprintf("%g, %g", *p.Location.Latitude, *p.Location.Longitude) }</p>
				<a href={ templ.URL(fmt.Sprintf("https://www.openstreetmap.org/directions?to=%g%%2C%g", *p.Location.Latitude, *p.Location.Longitude)) } rel="noreferrer">Navigate to service Location</a>
			}
		}
	</section>
}
