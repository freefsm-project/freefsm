package templates

import "fmt"
import "github.com/freefsm-project/freefsm/internal/authorization"

func leaseCents(v *int64) string { if v==nil {return ""};return fmt.Sprint(*v) }

templ LeaseBillingPage(p authorization.DraftLeaseBilling) {
	@Layout(p.Number+" Billing") {
		<h1>{ p.Number } Billing</h1>
		<p>Current lifecycle: {p.Lifecycle}</p>
		<a href="/leases?facet=billing">Leases — Billing</a> <a href={templ.URL(fmt.Sprintf("/leases/%d/billing/history",p.ID))}>Billing history</a>
		if p.Archived {
			<div role="status">Archived — read-only Billing history</div>
		}
		if p.GenerationFailure != "" {
			<h2>Last scheduler failure</h2>
			<p role="alert">{ p.GenerationFailure }</p>
		}
		if len(p.Failures) > 0 {
			<h2>Periods requiring retry (up to 100)</h2>
			for _, failure := range p.Failures {
				<p role="alert">{ failure.Kind } due { failure.DueOn }: { failure.Message }</p>
			}
		}
		if len(p.Periods) > 0 {
			<h2>Recent billing obligations (up to 100)</h2>
			for _, period := range p.Periods {
				<p><a href={ templ.URL(fmt.Sprintf("/leases/%d/billing/periods/%d",p.ID,period.ObligationID)) }>{ period.Kind } due { period.DueOn }</a></p>
				if len(period.ReviewFlags) > 0 {
					<p role="alert">Manual review required for generated billing in this period.</p>
				}
			}
		}
		if p.Finalized || p.Lifecycle != "draft" {
			<p>Finalized billing terms — read-only. Generated Invoices retain their original commercial facts. Amounts are whole cents; tax is a percentage.</p>
		} else {
			<p>Prospective Draft terms only. Saving creates no Invoice or billing obligation. Amounts are whole cents; tax is a percentage.</p>
		}
		if len(p.Terms)==0 {
			<p>No intended Assets. A base Lease manager can select them on the basic view.</p>
		}
		for _,term:=range p.Terms {
			<section aria-label={ fmt.Sprintf("Asset %d terms",term.AssetID) }>
				<h2>Asset { fmt.Sprint(term.AssetID) }</h2>
				if term.AssetArchived {
					<p>Archived Asset — retained terms only; repair before finalization.</p>
				}
				if !term.Selected {
					<p>Previously selected Asset — retained terms, not current intent.</p>
				}
				if p.CanManage && term.Selected {
					<form method="post" action={ templ.URL(fmt.Sprintf("/leases/%d/billing",p.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
						<input type="hidden" name="revision" value={ fmt.Sprint(p.Revision) }/>
						<input type="hidden" name="lifecycle_revision" value={ fmt.Sprint(p.LifecycleRevision) }/>
						<input type="hidden" name="asset_id" value={ fmt.Sprint(term.AssetID) }/>
						<label>Initial amount (cents)<input name="initial_cents" inputmode="numeric" value={ leaseCents(term.InitialCents) }/></label>
						<label>Monthly rent (cents)<input name="rent_cents" inputmode="numeric" value={ leaseCents(term.RentCents) }/></label>
						<label>Tax rate (%)<input name="tax_rate" inputmode="decimal" value={ term.TaxRate }/></label>
						<label>Initial due date<input name="initial_due_on" type="date" value={ p.InitialDueOn }/></label>
						<button type="submit">Save Billing terms</button>
					</form>
				} else {
					<dl><dt>Initial cents</dt><dd>{ leaseCents(term.InitialCents) }</dd><dt>Monthly rent cents</dt><dd>{ leaseCents(term.RentCents) }</dd><dt>Tax rate</dt><dd>{ term.TaxRate }</dd><dt>Initial due date</dt><dd>{ p.InitialDueOn }</dd></dl>
				}
			</section>
		}
	}
}
