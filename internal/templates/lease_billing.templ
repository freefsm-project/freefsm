package templates

import "fmt"
import "net/url"
import "github.com/freefsm-project/freefsm/internal/authorization"

func leaseCents(v *int64) string { if v==nil {return ""};return fmt.Sprint(*v) }

func leaseBillingQuerySuffix(q authorization.LeaseBillingQuery) string {
 if q.Page==1 && q.PerPage==25 && q.Filter=="all" {return ""}
 return "?"+url.Values{"page":{fmt.Sprint(q.Page)},"per_page":{fmt.Sprint(q.PerPage)},"filter":{q.Filter}}.Encode()
}

func LeaseBillingPeriodURL(lease,obligation int64,q authorization.LeaseBillingQuery)string {
 return fmt.Sprintf("/leases/%d/billing/periods/%d",lease,obligation)+leaseBillingQuerySuffix(q)
}

func leaseBillingListURL(lease int64,q authorization.LeaseBillingQuery,page int,filter string)string {
 q.Page=page;q.Filter=filter
 return fmt.Sprintf("/leases/%d/billing",lease)+leaseBillingQuerySuffix(q)
}

func leaseBillingLastPage(p authorization.DraftLeaseBilling)int {return max(1,(p.Total+p.Query.PerPage-1)/p.Query.PerPage)}

templ LeaseBillingPage(p authorization.DraftLeaseBilling) {
	@Layout(p.Number+" Billing") {
		<h1>{ p.Number } Billing</h1>
		<p>Current lifecycle: {p.Lifecycle}</p>
		<a href="/leases?facet=billing">Leases — Billing</a> <a href={templ.URL(fmt.Sprintf("/leases/%d/billing/history",p.ID))}>Billing history</a>
		if p.Archived {
			<div role="status">Archived — read-only Billing history</div>
		}
		if p.GenerationFailure != "" {
			<h2>Last scheduler failure</h2>
			<p role="alert">{ p.GenerationFailure }</p>
		}
		if p.Finalized {
			<a href={ templ.URL(fmt.Sprintf("/leases/%d/billing/revisions",p.ID)) }>Revise billing and view effective terms</a>
			<a href={ templ.URL(fmt.Sprintf("/leases/%d/billing/adjustments",p.ID)) }>Manual abatements, fees and damages</a>
		}
		if p.Finalized && !p.Archived {
			<h2>Billing periods</h2>
			<nav aria-label="Billing period filters">
				<a href={ templ.URL(leaseBillingListURL(p.ID,p.Query,1,"all")) }>All periods</a>
				<a href={ templ.URL(leaseBillingListURL(p.ID,p.Query,1,"review")) }>Review required</a>
				<a href={ templ.URL(leaseBillingListURL(p.ID,p.Query,1,"failed")) }>Periods requiring retry</a>
			</nav>
			<form method="get" action={ templ.URL(fmt.Sprintf("/leases/%d/billing",p.ID)) }>
				<label for="billing-period-filter">Filter</label><select id="billing-period-filter" name="filter">
					<option value="all" selected?={p.Query.Filter=="all"}>All periods</option>
					<option value="review" selected?={p.Query.Filter=="review"}>Review required</option>
					<option value="failed" selected?={p.Query.Filter=="failed"}>Failed periods</option>
				</select>
				<label for="billing-period-size">Per page</label><select id="billing-period-size" name="per_page">
					for _, size := range []int{25,50,100} {
						<option value={fmt.Sprint(size)} selected?={p.Query.PerPage==size}>{fmt.Sprint(size)}</option>
					}
				</select><button>Apply</button>
			</form>
			<p>{fmt.Sprint(p.Total)} billing periods</p>
			<ul aria-label="Billing periods">
				for _, period := range p.Periods {
					<li>
						if period.ObligationID != 0 {
							<a href={ templ.URL(LeaseBillingPeriodURL(p.ID,period.ObligationID,p.Query)) }>{ period.Kind } due { period.DueOn }</a>
						} else {
							<span>{ period.Kind } due { period.DueOn }</span><p>No obligation materialized.</p>
						}
						if period.ReviewRequired {
							<p role="alert">Manual review required for generated billing in this period.</p>
						}
						if period.Failure != "" {
							<p role="alert">{ period.Failure }</p>
						}
					</li>
				}
			</ul>
			<nav aria-label="Billing period pages">
				<p>Page {fmt.Sprint(p.Query.Page)} of {fmt.Sprint(leaseBillingLastPage(p))}</p>
				if p.Query.Page > 1 {
					<a href={templ.URL(leaseBillingListURL(p.ID,p.Query,1,p.Query.Filter))}>First</a>
					<a href={templ.URL(leaseBillingListURL(p.ID,p.Query,p.Query.Page-1,p.Query.Filter))}>Previous</a>
				}
				if p.Query.Page < leaseBillingLastPage(p) {
					<a href={templ.URL(leaseBillingListURL(p.ID,p.Query,p.Query.Page+1,p.Query.Filter))}>Next</a>
				}
				if p.Query.Page != leaseBillingLastPage(p) {
					<a href={templ.URL(leaseBillingListURL(p.ID,p.Query,leaseBillingLastPage(p),p.Query.Filter))}>Last</a>
				}
			</nav>
		}
		if p.Finalized || p.Lifecycle != "draft" {
			<p>Original finalized billing terms — read-only. Effective billing revisions and coverage changes govern later ungenerated charges; consult the revision history and each period preview. Generated Invoices retain their original commercial facts. Amounts are whole cents; tax is a percentage.</p>
		} else {
			<p>Prospective Draft terms only. Saving creates no Invoice or billing obligation. Amounts are whole cents; tax is a percentage.</p>
		}
		if len(p.Terms)==0 {
			<p>No intended Assets. A base Lease manager can select them on the basic view.</p>
		}
		for _,term:=range p.Terms {
			<section aria-label={ fmt.Sprintf("Asset %d terms",term.AssetID) }>
				<h2>Asset { fmt.Sprint(term.AssetID) }</h2>
				if term.AssetArchived {
					<p>Archived Asset — retained terms only; repair before finalization.</p>
				}
				if !term.Selected {
					<p>Previously selected Asset — retained terms, not current intent.</p>
				}
				if p.CanManage && term.Selected {
					<form method="post" action={ templ.URL(fmt.Sprintf("/leases/%d/billing",p.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
						<input type="hidden" name="revision" value={ fmt.Sprint(p.Revision) }/>
						<input type="hidden" name="lifecycle_revision" value={ fmt.Sprint(p.LifecycleRevision) }/>
						<input type="hidden" name="asset_id" value={ fmt.Sprint(term.AssetID) }/>
						<label>Initial amount (cents)<input name="initial_cents" inputmode="numeric" value={ leaseCents(term.InitialCents) }/></label>
						<label>Monthly rent (cents)<input name="rent_cents" inputmode="numeric" value={ leaseCents(term.RentCents) }/></label>
						<label>Tax rate (%)<input name="tax_rate" inputmode="decimal" value={ term.TaxRate }/></label>
						<label>Initial due date<input name="initial_due_on" type="date" value={ p.InitialDueOn }/></label>
						<button type="submit">Save Billing terms</button>
					</form>
				} else {
					<dl><dt>Initial cents</dt><dd>{ leaseCents(term.InitialCents) }</dd><dt>Monthly rent cents</dt><dd>{ leaseCents(term.RentCents) }</dd><dt>Tax rate</dt><dd>{ term.TaxRate }</dd><dt>Initial due date</dt><dd>{ p.InitialDueOn }</dd></dl>
				}
			</section>
		}
	}
}
