package templates

import "fmt"

templ TimeEntryShow(p TimeEntryShowPageData) {
	@Layout("Time Entry - "+p.UserName) {
		<div class="work-item-detail">
		if p.NeedsReview {
			<p role="alert">Recorded interval requires review. Its original facts have been retained. An authorized reviewer must check the source records and make a reasoned correction or terminal Void; no time is shifted automatically.</p>
		}
		if p.Voided {
			<p role="status">Voided — terminal. Repair by creating a replacement closed manual entry.</p>
		}
		if p.CanVoid {
			<form action={ templ.URL(fmt.Sprintf("/time-entries/%d/void", p.ID)) } method="post" hx-boost="false" data-save-terminal onsubmit="return confirm('Void this Time Entry permanently? Its recorded facts will be retained and excluded from totals.');">
				<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
				<label>Reason for Void <input name="reason" required/></label>
				<button type="submit" class="outline contrast">Void Time Entry</button>
			</form>
		}
		<div class="work-item-detail-actions">
			<div class="work-item-detail-action-group">
				if p.CanEdit {
					<a href={ templ.URL(fmt.Sprintf("/time-entries/%d/edit", p.ID)) } role="button" class="outline">Edit</a>
				}
				if p.CanDelete {
				<form action={ templ.URL(fmt.Sprintf("/time-entries/%d/delete", p.ID)) } method="post" hx-confirm="Delete this time entry?">
					<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
					<button class="outline contrast">Delete</button>
				</form>
				}
			</div>
		</div>
		<table class="work-item-detail-meta">
			<tbody>
				<tr><th>User</th><td>{ p.UserName }</td></tr>
				<tr><th>Job</th><td>
					if p.JobID > 0 && p.CanJob {
						<a href={ templ.URL(fmt.Sprintf("/jobs/%d", p.JobID)) }>{ p.JobName }</a>
					} else if p.JobID > 0 {
						<span>Job #{ fmt.Sprint(p.JobID) } — { p.JobName } (retained identity only)</span>
					} else {
						-
					}
				</td></tr>
				<tr><th>Clock In</th><td>{ p.ClockIn }</td></tr>
				<tr><th>Clock Out</th><td>{ p.ClockOut }</td></tr>
				<tr><th>Duration</th><td>{ p.Duration }</td></tr>
				<tr><th>Manual Entry</th><td>
					if p.IsManual {
						<mark>Yes</mark>
					} else {
						No
					}
				</td></tr>
				if p.Notes != "" {
					<tr><th>Notes</th><td class="work-item-detail-prewrap">{ p.Notes }</td></tr>
				}
				if p.GPSLat != "" || p.GPSLon != "" {
					<tr><th>Recorded legacy GPS</th><td>{ p.GPSLat }, { p.GPSLon } (capture time not recorded)</td></tr>
				}
				if p.GPSIn != "" {
					<tr><th>Clock-in GPS</th><td>{ p.GPSIn }</td></tr>
				}
				if p.GPSOut != "" {
					<tr><th>Clock-out GPS</th><td>{ p.GPSOut }</td></tr>
				}
			</tbody>
		</table>
		<section aria-label="Immutable time history">
			<h2>Immutable time history</h2>
			<p>Retained-at-upgrade records describe only facts known at upgrade, not an inferred original revision. GPS observations retain their actual capture times separately.</p>
			for _, revision := range p.History {
				<article>
					<h3>{ revision.Event }</h3>
					<p>{ revision.Actor } — accepted { revision.AcceptedAt }</p>
					<p>{ revision.Reason }</p>
					if revision.Before != "" {
						<p><strong>Before: </strong>{ revision.Before }</p>
					}
					<p><strong>After: </strong>{ revision.After }</p>
				</article>
			}
		</section>
		<div hx-get={ templ.URL(fmt.Sprintf("/time-entries/%d/activity", p.ID)) } hx-trigger="load" hx-swap="innerHTML">
			<p>Loading activity...</p>
		</div>
		<p class="work-item-detail-back"><a href="/time-entries">&larr; Back to Timesheets</a></p>
		</div>
	}
}
