package templates

import "fmt"
import "net/url"

func itemListScope(archived bool) url.Values {
	if archived { return url.Values{"archived": {"1"}} }
	return nil
}

templ ItemsIndex(p ItemListPageData) {
	@Layout("Items") {
		@ItemsListContent(p)

		<div hx-get="/items/activity" hx-trigger="load" hx-swap="innerHTML" class="shared-widget">
			<p>Loading recent activity...</p>
		</div>
	}
}

templ ItemsListContent(p ItemListPageData) {
	<div id="item-list-content" class="focused-list-content">
		if itemPermission(ctx, "item.archived.view") {
			<nav aria-label="Item archive views">
				<a href="/items">Current Items</a>
				<a href="/items?archived=1">Archived Items</a>
			</nav>
		}
		if itemPermission(ctx, "item.create") {
		@ListToolbar(ListToolbarData{
			Action: "/items", Target: "#item-list-content", Search: p.Search, Scope: itemListScope(p.Archived),
			SearchPlaceholder: "Search by name or SKU...", NewURL: "/items/new", NewLabel: "New Item",
		})
		} else {
		@ListToolbar(ListToolbarData{Action: "/items", Target: "#item-list-content", Search: p.Search, SearchPlaceholder: "Search Items...", Scope: itemListScope(p.Archived)})
		}
		@ItemsTable(p)
	</div>
}

templ ItemsTable(p ItemListPageData) {
	<div class="focused-list-results">
		<div class="work-queue-wrap">
			<table class="work-queue-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Type</th>
					if itemPermission(ctx, "pricebook.view") {
						<th>SKU</th><th>Price</th>
					}
					<th>Active</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				if len(p.Items) == 0 {
					<tr><td colspan="6" class="work-queue-empty">
						<p>No items found.</p>
						if itemPermission(ctx, "item.create") {
							<a href="/items/new" role="button" class="outline">Create your first item</a>
						}
					</td></tr>
				}
				for _, i := range p.Items {
					<tr>
						<td>
							<a href={ templ.URL(fmt.Sprintf("/items/%d", i.ID)) } class="work-queue-title">{ i.Name }</a>
							if p.Archived {
								<mark>Archived</mark>
							}
						</td>
						<td><mark>{ i.Type }</mark></td>
						if itemPermission(ctx, "pricebook.view") {
							<td>{ i.Sku }</td><td>{ fmt.Sprintf("$%.2f", i.UnitPrice) }</td>
						}
						<td>
							if i.IsActive {
								<ins>&check;</ins>
							} else {
								<del>&cross;</del>
							}
						</td>
						<td class="work-queue-actions">
							if !p.Archived && (itemPermission(ctx, "item.edit") || itemPermission(ctx, "pricebook.edit") || itemPermission(ctx, "cost.edit")) {
							<a href={ templ.URL(fmt.Sprintf("/items/%d/edit", i.ID)) } role="button" class="outline small" aria-label={ fmt.Sprintf("Edit %s", i.Name) }>Edit</a>
							}
							if !p.Archived && itemPermission(ctx, "item.archive") {
							<form action={ templ.URL(fmt.Sprintf("/items/%d/delete", i.ID)) } method="post" hx-confirm="Archive this item?">
								<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
								<button class="outline contrast small" aria-label={ fmt.Sprintf("Archive %s", i.Name) }>Archive</button>
							</form>
							}
						</td>
					</tr>
				}
			</tbody>
			</table>
		</div>
		@Pagination(PaginationData{
			CurrentPage: p.Page,
			TotalPages:  p.TotalPages,
			BaseURL:     "/items",
			Query:       listQuery(p.Search, nil, itemListScope(p.Archived)),
			Target:      "#item-list-content",
		})
	</div>
}
