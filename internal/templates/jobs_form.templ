package templates

import "fmt"

templ JobForm(p JobFormPageData) {
	@Layout(jobFormTitle(p.Job.ID)) {

		<form action={ templ.URL(jobFormAction(p.Job.ID)) } method="post" hx-boost="false" autocomplete="off" class="compact-form" hx-history="false">
			<input type="hidden" name="csrf_token" value={ csrfToken(ctx) }/>
			<input type="hidden" name="form_mode" value={ jobFormMode(p.Job.ID) }/>
			<input type="hidden" name="job_id" value={ fmt.Sprintf("%d", p.Job.ID) }/>
			<p>Dates and times use { companyTimeZone(ctx) }.</p>
			<label>
				Customer <small class="required-marker">*</small>
				<select name="customer_id" id="job-customer-select" required disabled?={ p.Job.ID>0 && !canMaster(ctx,"customer.view") }>
					<option value="">Select a customer...</option>
					for _, c := range p.Customers {
						<option value={ fmt.Sprintf("%d", c.Value) } selected?={ p.Job.CustomerID == c.Value }>{ c.Label }</option>
					}
				</select>
				if p.Errors["customer_id"] != "" {
					<small class="error-msg">{ p.Errors["customer_id"] }</small>
				}
			</label>
			if p.Job.ID > 0 && canDispatchJob(ctx) {
				if canMaster(ctx,"customer.view") {
					<label><input type="checkbox" name="replace_customer" value="true"/> Replace Customer deliberately and clear all operational Location, Project, Contact and Asset links. Linked Estimates and editable Draft Invoices move to this Customer and recalculate under current adjustment and tax rules, including exemption. Recorded PDF versions remain unchanged. Finalized or settled Invoices and Service Entries block replacement.</label>
				}
				<a href={ templ.URL(fmt.Sprintf("/jobs/%d/contacts",p.Job.ID)) }>Manage explicit Job Contacts</a>
			}
			<div class="grid">
				<label>
					Project (optional)
					<span class="select-with-action">
						<select name="project_id" id="job-project-select" disabled?={ !canMaster(ctx,"job.relations.edit") || !canMaster(ctx,"project.view") } data-retained-project={ fmt.Sprint(p.RetainedProjectID) } data-selected={ fmt.Sprintf("%d", p.Job.ProjectID) }>
							<option value="0">No project</option>
							for _, pr := range p.Projects {
								<option value={ fmt.Sprintf("%d", pr.Value) } selected?={ p.Job.ProjectID == pr.Value }>{ pr.Label }</option>
							}
						</select>
						<button type="button" class="outline select-action-button" onclick="openJobCreateModal('project')">Create</button>
					</span>
				</label>
				<label>
					Location (optional)
					<span class="select-with-action">
						<select name="location_id" id="job-location-select" disabled?={ !canMaster(ctx,"job.relations.edit") || !canMaster(ctx,"location.view") } data-selected={ fmt.Sprintf("%d", p.Job.LocationID) }>
							<option value="0">No location</option>
							for _, l := range p.Locations {
								<option value={ fmt.Sprintf("%d", l.Value) } selected?={ p.Job.LocationID == l.Value }>{ l.Label }</option>
							}
						</select>
						<button type="button" class="outline select-action-button" onclick="openJobCreateModal('location')">Create</button>
					</span>
				</label>
			</div>
	<div class="grid">
		<label>
			Asset (optional)
			<span class="select-with-action">
				<select name="asset_id" id="job-asset-select" disabled?={ !canMaster(ctx,"job.relations.edit") || !canMaster(ctx,"asset.view") } data-selected={ fmt.Sprintf("%d", p.Job.AssetID) }>
					<option value="0">No asset</option>
					for _, a := range p.Assets {
						<option value={ fmt.Sprintf("%d", a.Value) } selected?={ p.Job.AssetID == a.Value }>{ a.Label }</option>
					}
				</select>
				<button type="button" class="outline select-action-button" onclick="openJobCreateModal('asset')">Create</button>
			</span>
			</label>
		<label>
			Contact (optional)
			<span class="select-with-action">
				<select name="customer_contact_id" id="contact-select" disabled?={ !canMaster(ctx,"job.relations.edit") || !canMaster(ctx,"contact.view") } data-selected={ fmt.Sprintf("%d", p.Job.ContactID) }>
					<option value="0">No contact</option>
				</select>
				<button type="button" class="outline select-action-button" onclick="openJobCreateModal('contact')">Create</button>
			</span>
		</label>
	</div>
	<div class="grid">
		<label>
			Job Title <small class="required-marker">*</small>
			<input type="text" name="job_type" value={ p.Job.JobType } placeholder="e.g. Installation, Repair" required/>
			if p.Errors["job_type"] != "" {
				<small class="error-msg">{ p.Errors["job_type"] }</small>
			}
		</label>
		<label>
			Subtitle
			<input type="text" name="subtitle" value={ p.Job.Subtitle } placeholder="Optional"/>
		</label>
	</div>
			if p.Job.ID > 0 {
				<p>Schedule, arrival window and equal assignees are reviewed together in <a href={ templ.URL(fmt.Sprintf("/jobs/%d/dispatch",p.Job.ID)) }>Dispatch Job</a>.</p>
			}
			if p.Pricing != nil {
				<p>Captured Job pricing is independent of the catalog. Later catalog edits do not change these values.</p>
				@LineItemEditor(*p.Pricing)
			}
			if p.Job.ID == 0 || p.Pricing != nil {
				<div class="grid">
					<label>
						Billing Type
						<select name="billing_type">
							for _, b := range p.BillingTypes {
								<option value={ b } selected?={ p.Job.BillingType == b }>{ b }</option>
							}
						</select>
					</label>
				</div>
			}
			<label>
				Due Date
				<input type="date" name="due_date" value={ p.Job.DueDate }/>
			</label>
			<label>
				Notes
				<textarea name="notes" rows="3">{ p.Job.Notes }</textarea>
			</label>
			if p.Job.ID > 0 {
			 <p>Field Notes are saved independently. <a href={ templ.URL(fmt.Sprintf("/jobs/%d/field-notes",p.Job.ID)) }>Open Field Notes</a></p>
			}
			<input type="hidden" name="field_baseline" value={ p.FieldBaseline }/>
			@CustomFieldsWidget(CustomFieldsWidgetData{Fields: p.CustomFields, EditMode: canEditJobFields(ctx,p.Job.ID)})
			<fieldset x-data="subtasksEditor()" data-existing={ p.ExistingSubtasksJSON }>
				<legend>Subtasks</legend>
				<table>
					<thead><tr><th>Title</th><th>Order</th><th></th></tr></thead>
					<tbody>
						<template x-for="(st, idx) in items" :key="st.id || st.draftKey">
							<tr>
								<td><input type="text" x-model="st.title" placeholder="e.g. Pre-site survey" aria-label="Subtask title"></td>
								<td><input type="number" x-model.number="st.sort_order" min="0" class="input-width-70" aria-label="Subtask display order"></td>
								<td><button @click.prevent="remove(idx)" class="outline contrast small" aria-label="Remove subtask">X</button></td>
							</tr>
						</template>
					</tbody>
				</table>
				<button @click.prevent="add()" class="outline">+ Add Subtask</button>
				<input type="hidden" name="subtasks" :value="json">
			</fieldset>
			<div class="entity-form-actions">
				<button type="submit">Save</button>
				if p.PendingNextOccurrence {
					<button type="submit" class="outline" formaction={ templ.URL(fmt.Sprintf("/jobs/%d/cancel-next-occurrence", p.Job.ID)) } formmethod="post" formnovalidate>Cancel</button>
				} else {
					<a href={ templ.URL(navigationReturnURL(ctx, "/jobs")) } role="button" class="outline">Cancel</a>
				}
			</div>
		</form>
		@templ.Raw(`<script>
			const jobCustomer = document.getElementById('job-customer-select');
			const jobProjectSelect = document.getElementById('job-project-select');
			const contactSelect = document.getElementById('contact-select');
			const jobLocationSelect = document.getElementById('job-location-select');
			const jobAssetSelect = document.getElementById('job-asset-select');
			function selectedJobCustomerID() { return jobCustomer ? jobCustomer.value : ''; }
			function csrfToken() {
				return document.querySelector('meta[name="csrf-token"]')?.content || '';
			}
			const jobLookupControllers = new WeakMap();
			const jobLookupValues = new WeakMap();
			const jobLookupLabels = { 'contact-select': 'Contact', 'job-project-select': 'Project', 'job-location-select': 'Location', 'job-asset-select': 'Asset' };
			function unresolvedJobChoices(scope) {
				return [...scope.querySelectorAll('select[data-lookup-state]')].filter(select => !['ready', 'empty'].includes(select.dataset.lookupState));
			}
			function syncJobLookupGuard(scope) {
				if (!scope) return;
				const blocked = unresolvedJobChoices(scope).length > 0 || !!scope.dataset.creationFieldsLoading || (scope.matches('#job-project-dialog, #job-asset-dialog') && !scope.dataset.creationFieldsReady);
				scope.querySelectorAll('button[type="submit"], button[id$="-create-button"]').forEach(button => {
					if (blocked && !button.disabled) { button.disabled = true; button.dataset.lookupDisabled = 'true'; }
					else if (!blocked && button.dataset.lookupDisabled) { button.disabled = false; delete button.dataset.lookupDisabled; }
				});
			}
			function holdJobChoice(select, hold) {
				// Disabled selects are omitted from FormData. Retain only their exact
				// value in the same position; submission is separately blocked until
				// lookup succeeds, so a failed refresh never silently means Clear.
				let value = jobLookupValues.get(select);
				if (hold && select.name) {
					if (!value) { value = document.createElement('input'); value.type = 'hidden'; value.name = select.name; select.after(value); jobLookupValues.set(select, value); }
					value.value = select.value;
				} else if (value) { value.remove(); jobLookupValues.delete(select); }
				select.disabled = hold;
			}
			function jobChoiceNotice(select, state, message, retry) {
				let notice = document.getElementById(select.id + '-lookup-status');
				if (!notice) {
					notice = document.createElement('p'); notice.id = select.id + '-lookup-status'; notice.tabIndex = -1;
					(select.closest('label') || select).after(notice);
					select.setAttribute('aria-describedby', ((select.getAttribute('aria-describedby') || '') + ' ' + notice.id).trim());
				}
				select.dataset.lookupState = state; select.setAttribute('aria-busy', String(state === 'loading'));
				notice.setAttribute('role', ['failed', 'denied', 'needs-selection'].includes(state) ? 'alert' : 'status');
				notice.textContent = message; notice.hidden = !message;
				if (retry) {
					const button = document.createElement('button'); button.type = 'button'; button.className = 'outline small';
					button.textContent = 'Retry ' + (jobLookupLabels[select.id] || 'Location') + ' choices'; button.onclick = retry; notice.append(button);
				}
				syncJobLookupGuard(select.closest('form, dialog'));
			}
			[jobProjectSelect, contactSelect, jobLocationSelect, jobAssetSelect].filter(Boolean).forEach(select => { select.dataset.planningLocked = String(select.disabled); select.dataset.lookupCustomer = selectedJobCustomerID(); });
			if (jobCustomer?.form) jobCustomer.form.addEventListener('submit', event => {
				const blocked = unresolvedJobChoices(jobCustomer.form);
				if (!blocked.length) return;
				event.preventDefault(); event.stopImmediatePropagation();
				document.getElementById(blocked[0].id + '-lookup-status')?.focus();
			}, true);
			function refreshOptions(select, emptyHTML, url, selectedID) {
				if (!select) return Promise.resolve();
				if (select.dataset.planningLocked === 'true') return Promise.resolve(true);
				const requestID = String((Number(select.dataset.refreshRequest || '0') || 0) + 1);
				select.dataset.refreshRequest = requestID;
				jobLookupControllers.get(select)?.abort();
				const customerID = selectedJobCustomerID();
				const changedCustomer = select.dataset.lookupCustomer !== customerID;
				select.dataset.lookupCustomer = customerID;
				const desired = String(changedCustomer ? 0 : (selectedID || 0));
				select.dataset.selected = desired;
				if (changedCustomer || !url) select.innerHTML = emptyHTML;
				if (!url) { holdJobChoice(select, false); jobChoiceNotice(select, 'empty', ''); return Promise.resolve(true); }
				if (desired !== '0' && ![...select.options].some(option => option.value === desired)) select.add(new Option('Current selection (checking availability)', desired));
				select.value = desired;
				if (!select.dataset.lookupManaged) {
					select.dataset.lookupManaged = 'true';
					select.addEventListener('change', () => {
						select.dataset.selected = select.value;
						if (select.dataset.lookupState === 'needs-selection' && select.value !== '') { select.setCustomValidity(''); jobChoiceNotice(select, 'ready', 'Selection reviewed. Save explicitly to apply it.'); }
					});
				}
				select.setCustomValidity(''); holdJobChoice(select, true);
				jobChoiceNotice(select, 'loading', 'Loading ' + (jobLookupLabels[select.id] || 'Location') + ' choices; Save waits for confirmation.');
				const controller = new AbortController(); jobLookupControllers.set(select, controller);
				const timeout = setTimeout(() => controller.abort(), 15000);
				return fetch(url + '?selected=' + encodeURIComponent(desired), {cache: 'no-store', signal: controller.signal})
					.then(async response => {
						if (!response.ok || response.redirected) { const error = new Error('lookup unavailable'); error.status = response.redirected ? 401 : response.status; throw error; }
						const html = await response.text();
						if (select.dataset.refreshRequest !== requestID) return;
						if (!select.isConnected) return;
						const fragment = document.createElement('template'); fragment.innerHTML = html;
							const options = [...fragment.content.children];
							if (!changedCustomer && desired !== '0' && select.dataset.retainedProject === desired && !options.some(option => option.value === desired)) options.push(new Option('Retain historical Project',desired));
						if (!options.length || options.some(option => option.tagName !== 'OPTION') || !options.some(option => option.value === '0')) throw new Error('invalid option response');
						select.replaceChildren(...options.map(option => new Option(option.textContent, option.value)));
						holdJobChoice(select, false);
						if (!options.some(option => option.value === desired)) {
							const missing = new Option('Previous selection unavailable — choose a permitted replacement', '', true, true); missing.disabled = true; select.prepend(missing); select.value = '';
							select.setCustomValidity('Review this unavailable selection before saving.');
							jobChoiceNotice(select, 'needs-selection', 'The previous selection is no longer available. Choose an authorized replacement or explicitly choose No selection.');
							return false;
						}
						select.value = desired;
						jobChoiceNotice(select, 'ready', options.length === 1 ? 'No available choices for this Customer.' : '');
						return true;
					}).catch(error => {
						if (select.dataset.refreshRequest !== requestID || !select.isConnected) return false;
						if (error.status === 401) {
							if (window.freefsmActions) window.freefsmActions.accessUnavailable(401);
							else location.assign('/login');
							return false;
						}
						const denied = [403, 404].includes(error.status);
						if (denied) {
							select.innerHTML = emptyHTML;
							if (desired !== '0') select.add(new Option('Current selection unavailable', desired));
							select.value = desired;
						}
						holdJobChoice(select, true);
						jobChoiceNotice(select, denied ? 'denied' : 'failed', denied ? 'Choices are not accessible. Labels have been removed. Review access and retry before saving.' : 'Choices unavailable. Previous selection is retained, not refreshed. Retry before saving.', () => refreshOptions(select, emptyHTML, url, desired));
						return false;
					}).finally(() => clearTimeout(timeout));
			}
			function selectInlineOption(select, created) {
				if (!select || !created || !created.id) return;
				if (select.dataset.lookupState && !['ready', 'empty'].includes(select.dataset.lookupState)) return;
				const value = String(created.id);
				if (![...select.options].some(option => option.value === value)) {
					const option = document.createElement('option');
					option.value = value;
					option.textContent = created.label || value;
					select.appendChild(option);
				}
				select.dataset.selected = value;
				select.value = value;
			}
			function loadJobProjects(customerID, selectedID) {
				return refreshOptions(jobProjectSelect, '<option value="0">No project</option>', customerID ? '/customers/' + customerID + '/projects/options' : '', selectedID ?? (jobProjectSelect ? jobProjectSelect.dataset.selected : 0));
			}
			function loadContacts(customerID) {
				return refreshOptions(contactSelect, '<option value="0">No contact</option>', customerID ? '/customers/' + customerID + '/contacts/options' : '', contactSelect ? contactSelect.dataset.selected : 0);
			}
			function loadJobLocations(customerID, selectedID) {
				return refreshOptions(jobLocationSelect, '<option value="0">No location</option>', customerID ? '/customers/' + customerID + '/locations/options' : '', selectedID ?? (jobLocationSelect ? jobLocationSelect.dataset.selected : 0));
			}
			function loadJobAssets(customerID, selectedID) {
				return refreshOptions(jobAssetSelect, '<option value="0">No asset</option>', customerID ? '/customers/' + customerID + '/assets/options' : '', selectedID ?? (jobAssetSelect ? jobAssetSelect.dataset.selected : 0));
			}
			function loadModalLocations(selectID, selectedID) {
				const select = document.getElementById(selectID);
				const customerID = selectedJobCustomerID();
				return refreshOptions(select, '<option value="0">No location</option>', customerID ? '/customers/' + customerID + '/locations/options' : '', selectedID || 0);
			}
			function setJobModalError(type, message) {
				const el = document.getElementById('job-' + type + '-error');
				if (!el) return;
				el.textContent = message || '';
				el.hidden = !message;
			}
			async function openJobCreateModal(type) {
				const dialog = document.getElementById('job-' + type + '-dialog');
				if (!dialog) return;
				setJobModalError(type, '');
				if (!selectedJobCustomerID()) setJobModalError(type, 'Select a customer before creating a ' + type + '.');
				if (type === 'asset') loadModalLocations('job-asset-location-id', jobLocationSelect ? jobLocationSelect.value : 0);
				if (type === 'project') loadModalLocations('job-project-location-id', jobLocationSelect ? jobLocationSelect.value : 0);
				// Initialize once per creation attempt from the existing authorized
				// creation form. Error-response controls contain entered answers, so
				// their DOM defaults cannot be used to initialize another record.
				if ((type === 'asset' || type === 'project') && !dialog.dataset.creationFieldsReady) {
					if (dialog.dataset.creationFieldsLoading) return;
					const button = document.getElementById('job-' + type + '-create-button');
					const target = dialog.querySelector('[data-inline-custom-fields]');
					dialog.dataset.creationFieldsLoading = 'true';
					button.disabled = true;
					try {
						const response = await fetch('/' + type + 's/new', {cache: 'no-store', redirect: 'error'});
						if (!response.ok) throw new Error('Unable to load creation fields. Close this dialog and try again.');
						const page = new DOMParser().parseFromString(await response.text(), 'text/html');
						const fields = page.querySelector('.custom-fields-grid');
						target.replaceChildren(...(fields ? [fields] : []));
						dialog.dataset.creationFieldsReady = 'true';
					} catch (err) {
						setJobModalError(type, err.message);
					} finally {
						delete dialog.dataset.creationFieldsLoading;
						button.disabled = !dialog.dataset.creationFieldsReady;
						syncJobLookupGuard(dialog);
					}
				}
				if (!dialog.open) dialog.showModal();
			}
			function closeJobCreateModal(type) {
				const dialog = document.getElementById('job-' + type + '-dialog');
				if (dialog && dialog.open) dialog.close();
			}
			function resetJobModalFields(prefix) {
				const dialog = document.getElementById('job-' + prefix + '-dialog');
				if (!dialog) return;
				dialog.querySelectorAll('[id^="job-' + prefix + '-"]').forEach(el => {
					if (el.id.endsWith('-error') || el.id.endsWith('-button') || el.tagName === 'DIALOG') return;
					if (el.type === 'checkbox') el.checked = false;
					else if (el.tagName === 'SELECT') el.value = '0';
					else if (el.id === 'job-project-completion-percentage') el.value = '0';
					else el.value = '';
				});
				const fields = dialog.querySelector('[data-inline-custom-fields]');
				if (fields) {
					fields.replaceChildren();
					delete dialog.dataset.creationFieldsReady;
				}
			}
			function postInline(url, fields) {
				const body = new URLSearchParams();
				fields.forEach(([name, value]) => body.set(name, value || ''));
				const type = url === '/assets/inline' ? 'asset' : url === '/projects/inline' ? 'project' : url.includes('/locations/') ? 'location' : url.includes('/contacts/') ? 'contact' : null;
				const dialog = type && document.getElementById('job-' + type + '-dialog');
				if (dialog && (unresolvedJobChoices(dialog).length || dialog.dataset.creationFieldsLoading)) return Promise.reject(new Error('Retry the unavailable choices before creating this record.'));
				if (dialog) dialog.querySelectorAll('[name^="custom_field_"]').forEach(el => {
					if (el.multiple) [...el.selectedOptions].forEach(option => body.append(el.name, option.value));
					else body.append(el.name, el.value);
				});
				return window.freefsmActions.fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrfToken() }, body }, dialog)
					.then(async r => {
						if (!r.ok) {
							const text = await r.text();
							const page = new DOMParser().parseFromString(text, 'text/html');
							const fields = page.querySelector('.custom-fields-grid');
							const target = dialog && dialog.querySelector('[data-inline-custom-fields]');
							if (r.status === 422 && fields && target) target.replaceChildren(fields);
							throw new Error(page.querySelector('[role="alert"]')?.textContent || page.body.textContent || 'Unable to create record.');
						}
						return r.json();
					});
			}
			async function createJobLocation() {
				const customerID = selectedJobCustomerID();
				if (!customerID) { setJobModalError('location', 'Select a customer before creating a location.'); return; }
				try {
					const created = await postInline('/customers/' + customerID + '/locations/inline', [
						['title', document.getElementById('job-location-title').value],
						['address_1', document.getElementById('job-location-address-1').value],
						['address_2', document.getElementById('job-location-address-2').value],
						['city', document.getElementById('job-location-city').value],
						['state', document.getElementById('job-location-state').value],
						['zip_code', document.getElementById('job-location-zip-code').value],
						['notes', document.getElementById('job-location-notes').value],
						['is_primary', document.getElementById('job-location-is-primary').checked ? 'true' : 'false'],
					]);
					await loadJobLocations(customerID, created.id);
					selectInlineOption(jobLocationSelect, created);
					await loadModalLocations('job-project-location-id', created.id);
					await loadModalLocations('job-asset-location-id', created.id);
					resetJobModalFields('location');
					closeJobCreateModal('location');
				} catch (err) { setJobModalError('location', err.message); }
			}
			async function createJobContact() {
				const customerID = selectedJobCustomerID();
				if (!customerID) { setJobModalError('contact', 'Select a customer before creating a contact.'); return; }
				try {
					const created = await postInline('/customers/' + customerID + '/contacts/inline', [
						['first_name', document.getElementById('job-contact-first-name').value],
						['last_name', document.getElementById('job-contact-last-name').value],
						['email', document.getElementById('job-contact-email').value],
						['phone', document.getElementById('job-contact-phone').value],
						['notes', document.getElementById('job-contact-notes').value],
					]);
					await loadContacts(customerID);
					selectInlineOption(contactSelect, created);
					resetJobModalFields('contact');
					closeJobCreateModal('contact');
				} catch (err) { setJobModalError('contact', err.message); }
			}
			async function createJobAsset() {
				const customerID = selectedJobCustomerID();
				if (!customerID) { setJobModalError('asset', 'Select a customer before creating an asset.'); return; }
				try {
					const created = await postInline('/assets/inline', [
						['number', document.getElementById('job-asset-number').value],
						['ownership_class', document.getElementById('job-asset-ownership-class').value],
						['customer_id', customerID],
						['name', document.getElementById('job-asset-name').value],
						['asset_type_id', document.getElementById('job-asset-type-id').value],
						['asset_status_id', document.getElementById('job-asset-status-id').value],
						['location_id', document.getElementById('job-asset-location-id').value],
						['manufacturer', document.getElementById('job-asset-manufacturer').value],
						['model', document.getElementById('job-asset-model').value],
						['serial_number', document.getElementById('job-asset-serial-number').value],
						['installed_at', document.getElementById('job-asset-installed-at').value],
						['warranty_expires', document.getElementById('job-asset-warranty-expires').value],
						['notes', document.getElementById('job-asset-notes').value],
					]);
					await loadJobAssets(customerID, created.id);
					selectInlineOption(jobAssetSelect, created);
					resetJobModalFields('asset');
					closeJobCreateModal('asset');
				} catch (err) { setJobModalError('asset', err.message); }
			}
			async function createJobProject() {
				const customerID = selectedJobCustomerID();
				if (!customerID) { setJobModalError('project', 'Select a customer before creating a project.'); return; }
				try {
					const created = await postInline('/projects/inline', [
						['customer_id', customerID],
						['name', document.getElementById('job-project-name').value],
						['description', document.getElementById('job-project-description').value],
						['status_id', document.getElementById('job-project-status-id').value],
						['location_id', document.getElementById('job-project-location-id').value],
						['completion_percentage', document.getElementById('job-project-completion-percentage').value],
						['start_time', document.getElementById('job-project-start-time').value],
						['end_time', document.getElementById('job-project-end-time').value],
						['notes', document.getElementById('job-project-notes').value],
					]);
					await loadJobProjects(customerID, created.id);
					selectInlineOption(jobProjectSelect, created);
					resetJobModalFields('project');
					closeJobCreateModal('project');
				} catch (err) { setJobModalError('project', err.message); }
			}
			if (jobCustomer) {
				jobCustomer.addEventListener('change', function() {
					if (jobProjectSelect) jobProjectSelect.dataset.selected = 0;
					if (contactSelect) contactSelect.dataset.selected = 0;
					if (jobLocationSelect) jobLocationSelect.dataset.selected = 0;
					if (jobAssetSelect) jobAssetSelect.dataset.selected = 0;
					loadJobProjects(this.value, 0);
					loadContacts(this.value);
					loadJobLocations(this.value, 0);
					loadJobAssets(this.value, 0);
				});
				if (jobCustomer.value) {
					if (jobProjectSelect && jobProjectSelect.options.length <= 1) loadJobProjects(jobCustomer.value);
					if (contactSelect) loadContacts(jobCustomer.value);
					if (jobLocationSelect && jobLocationSelect.options.length <= 1) loadJobLocations(jobCustomer.value);
					if (jobAssetSelect && jobAssetSelect.options.length <= 1) loadJobAssets(jobCustomer.value);
				}
			}
			function registerJobEditors() {
				Alpine.data('subtasksEditor', () => ({
					items: [],
					init() { try { this.items = JSON.parse(this.$el.dataset.existing || '[]').map(st => ({...st,draftKey:crypto.randomUUID()})); } catch(e) {} },
					add() { this.items.push({draftKey:crypto.randomUUID(),title:'',completed:false,sort_order:this.items.length+1}); },
					remove(idx) { this.items.splice(idx, 1); },
					get json() { return JSON.stringify(this.items.map(({draftKey,...st})=>st)); },
				}));
			}
			if (window.Alpine) { registerJobEditors(); } else { document.addEventListener('alpine:init', registerJobEditors); }
		</script>`)
		@JobQuickCreateDialogs(p)
	}
}

templ JobQuickCreateDialogs(p JobFormPageData) {
	<dialog class="item-create-dialog" id="job-project-dialog" onclick="if (event.target === this) closeJobCreateModal('project')">
		<article class="item-create-dialog-card">
			<header class="item-create-dialog-header">
				<strong>Create Project</strong>
				<button type="button" class="outline small" onclick="closeJobCreateModal('project')">Close</button>
			</header>
			<div class="item-create-dialog-body">
				<small class="error-msg" id="job-project-error" hidden></small>
				<label>Name <small class="required-marker">*</small><input type="text" id="job-project-name" required/></label>
				<label>Description <input type="text" id="job-project-description"/></label>
				<div class="grid">
					<label>Status
						<select id="job-project-status-id">
							<option value="0">No Status</option>
							for _, s := range p.ProjectStatuses {
								<option value={ fmt.Sprintf("%d", s.Value) }>{ s.Label }</option>
							}
						</select>
					</label>
					<label>Location
						<select id="job-project-location-id">
							<option value="0">No location</option>
						</select>
					</label>
				</div>
				<label>Completion (%) <input type="number" id="job-project-completion-percentage" value="0" min="0" max="100" step="1"/></label>
				<div class="grid">
					<label>Start Date <input type="date" id="job-project-start-time"/></label>
					<label>End Date <input type="date" id="job-project-end-time"/></label>
				</div>
				<label>Notes <textarea id="job-project-notes" rows="3"></textarea></label>
				<div data-inline-custom-fields>
					@CustomFieldsWidget(CustomFieldsWidgetData{Fields:p.ProjectCustomFields,EditMode:true})
				</div>
			</div>
			<footer class="item-create-dialog-actions">
				<button type="button" id="job-project-create-button" onclick="createJobProject()">Create Project</button>
				<button type="button" class="outline" onclick="closeJobCreateModal('project')">Cancel</button>
			</footer>
		</article>
	</dialog>
	<dialog class="item-create-dialog" id="job-location-dialog" onclick="if (event.target === this) closeJobCreateModal('location')">
		<article class="item-create-dialog-card">
			<header class="item-create-dialog-header">
				<strong>Create Location</strong>
				<button type="button" class="outline small" onclick="closeJobCreateModal('location')">Close</button>
			</header>
			<div class="item-create-dialog-body">
				<small class="error-msg" id="job-location-error" hidden></small>
				<label>Title <small class="required-marker">*</small><input type="text" id="job-location-title" required/></label>
				<div class="grid">
					<label>Address 1 <input type="text" id="job-location-address-1"/></label>
					<label>Address 2 <input type="text" id="job-location-address-2"/></label>
				</div>
				<div class="grid form-grid-address">
					<label>City <input type="text" id="job-location-city"/></label>
					<label>State <input type="text" id="job-location-state"/></label>
					<label>ZIP <input type="text" id="job-location-zip-code"/></label>
				</div>
				<label>Notes <input type="text" id="job-location-notes"/></label>
				<label><input type="checkbox" id="job-location-is-primary"/> Primary</label>
			</div>
			<footer class="item-create-dialog-actions">
				<button type="button" id="job-location-create-button" onclick="createJobLocation()">Create Location</button>
				<button type="button" class="outline" onclick="closeJobCreateModal('location')">Cancel</button>
			</footer>
		</article>
	</dialog>
	<dialog class="item-create-dialog" id="job-asset-dialog" onclick="if (event.target === this) closeJobCreateModal('asset')">
		<article class="item-create-dialog-card">
			<header class="item-create-dialog-header">
				<strong>Create Asset</strong>
				<button type="button" class="outline small" onclick="closeJobCreateModal('asset')">Close</button>
			</header>
			<div class="item-create-dialog-body">
				<small class="error-msg" id="job-asset-error" hidden></small>
				<label>Asset Number <input id="job-asset-number" placeholder="Automatically assigned if blank"/></label>
				<label>Ownership class
					<select id="job-asset-ownership-class" required>
						<option value="0">Choose ownership class</option>
						<option value="customer_owned">Customer-owned</option>
						<option value="company_owned">Company-owned</option>
					</select>
				</label>
				<label>Name <small class="required-marker">*</small><input type="text" id="job-asset-name" required/></label>
				<div class="grid">
					<label>Asset Type <small class="required-marker">*</small>
						<select id="job-asset-type-id" required>
							<option value="0">Select asset type...</option>
							for _, t := range p.AssetTypes {
								if !t.Retired {
								<option value={ fmt.Sprintf("%d", t.Value) }>{ t.Label }</option>
								}
							}
						</select>
					</label>
					<label>Status
						<select id="job-asset-status-id">
							<option value="0">No Status</option>
							for _, s := range p.AssetStatuses {
								if !s.Retired {
								<option value={ fmt.Sprintf("%d", s.Value) }>{ s.Label }</option>
								}
							}
						</select>
					</label>
				</div>
				<label>Location
					<select id="job-asset-location-id">
						<option value="0">No location</option>
					</select>
				</label>
				<div class="grid">
					<label>Manufacturer <input type="text" id="job-asset-manufacturer"/></label>
					<label>Model <input type="text" id="job-asset-model"/></label>
				</div>
				<label>Serial Number <input type="text" id="job-asset-serial-number"/></label>
				<div class="grid">
					<label>Installed At <input type="date" id="job-asset-installed-at"/></label>
					<label>Warranty Expires <input type="date" id="job-asset-warranty-expires"/></label>
				</div>
				<label>Notes <textarea id="job-asset-notes" rows="3"></textarea></label>
				<div data-inline-custom-fields>
					@CustomFieldsWidget(CustomFieldsWidgetData{Fields:p.AssetCustomFields,EditMode:true})
				</div>
			</div>
			<footer class="item-create-dialog-actions">
				<button type="button" id="job-asset-create-button" onclick="createJobAsset()">Create Asset</button>
				<button type="button" class="outline" onclick="closeJobCreateModal('asset')">Cancel</button>
			</footer>
		</article>
	</dialog>
	<dialog class="item-create-dialog" id="job-contact-dialog" onclick="if (event.target === this) closeJobCreateModal('contact')">
		<article class="item-create-dialog-card">
			<header class="item-create-dialog-header">
				<strong>Create Contact</strong>
				<button type="button" class="outline small" onclick="closeJobCreateModal('contact')">Close</button>
			</header>
			<div class="item-create-dialog-body">
				<small class="error-msg" id="job-contact-error" hidden></small>
				<div class="grid">
					<label>First <small class="required-marker">*</small><input type="text" id="job-contact-first-name" required/></label>
					<label>Last <input type="text" id="job-contact-last-name"/></label>
				</div>
				<div class="grid">
					<label>Email <input type="email" id="job-contact-email"/></label>
					<label>Phone <input type="tel" id="job-contact-phone"/></label>
				</div>
				<label>Notes <input type="text" id="job-contact-notes"/></label>
			</div>
			<footer class="item-create-dialog-actions">
				<button type="button" id="job-contact-create-button" onclick="createJobContact()">Create Contact</button>
				<button type="button" class="outline" onclick="closeJobCreateModal('contact')">Cancel</button>
			</footer>
		</article>
	</dialog>
}

templ AssetOptions(options []SelectOption, selectedID int64) {
	<option value="0">No asset</option>
	for _, o := range options {
		<option value={ fmt.Sprintf("%d", o.Value) } selected?={ selectedID == o.Value }>{ o.Label }</option>
	}
}
