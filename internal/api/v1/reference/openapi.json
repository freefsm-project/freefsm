{
 "openapi":"3.1.0",
 "jsonSchemaDialect":"https://json-schema.org/draft/2020-12/schema",
 "info":{"title":"FreeFSM v1 pairing, own-session and Subtask protocol","version":"1.0.0","description":"Interactive user protocol. Ten-minute pairing, authenticated hosted browser approval, one-use opaque bearer, exact-identity Subtask completion and immutable operation receipts. Other field-domain contracts evolve in their owning slices. No API password or refresh-token flow."},
 "servers":[{"url":"/api/v1"}],
 "security":[{"bearer":[]}],
 "paths":{
  "/jobs/{id}/field-notes":{"parameters":[{"$ref":"#/components/parameters/JobID"}],"get":{"operationId":"jobFieldNotes","responses":{"200":{"description":"Current shared notes and independent revision under current Job View","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobNotesEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}},"post":{"operationId":"editJobFieldNotes","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobNotesCommand"}}}},"responses":{"200":{"description":"Immutable terminal receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobExecutionReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/status":{"parameters":[{"$ref":"#/components/parameters/JobID"}],"post":{"operationId":"changeJobStatus","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobStatusCommand"}}}},"responses":{"200":{"description":"Immutable terminal receipt; same valid target preserves effect identity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobExecutionReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/status-intents":{"parameters":[{"$ref":"#/components/parameters/JobID"}],"get":{"operationId":"jobStatusIntents","responses":{"200":{"description":"Configured Status presentations and opaque revisions from one authorized snapshot","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobStatusIntentsEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/field-notes/history":{"parameters":[{"$ref":"#/components/parameters/JobID"}],"get":{"operationId":"jobFieldNotesHistory","responses":{"200":{"description":"Immutable authorized revisions; baseline author and acceptance time may be unknown","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobNotesHistoryEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/job-execution-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"jobExecutionReceipt","responses":{"200":{"description":"Requester's immutable receipt, including after resource loss or fresh sign-in. Contains no text or comparisons.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobExecutionReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/subtasks":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"get":{"operationId":"jobChecklist","description":"Current Job View (A or active assigned J). Returns active UUID-identified entries and immutable, parent-bounded history. Completed/Canceled Jobs remain actionable. Pending legacy review is explicit.","responses":{"200":{"description":"Authorized checklist","content":{"application/json":{"schema":{"type":"object","required":["data"],"properties":{"data":{"$ref":"#/components/schemas/Checklist"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/subtasks/{subtask}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}},{"name":"subtask","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"patch":{"operationId":"setSubtaskCompletion","description":"Complete/Reopen require their independent current J/A grant. Exact UUID, opaque completion revision and operation ID are mandatory; positional indices are not supported. Same-state is a no-op, stale opposite-state/ABA conflicts. Planning maintenance is browser-only. Terminal receipts survive resource scope loss; audit/storage failure is retryable under the same ID.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubtaskIntent"}}}},"responses":{"200":{"description":"Immutable operation receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubtaskReceiptEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"},"default":{"$ref":"#/components/responses/Error"}}}},
  "/subtask-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"subtaskReceipt","description":"Current authenticated user and exact client session only. Retains disposition, stable effect identity and acceptance time after Job access loss; never title, history or comparison data. Reconcile this original operation after a lost response before explicit retry or revised new intent.","responses":{"200":{"description":"Immutable nonsensitive receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubtaskReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/custom-fields":{
   "parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],
   "get":{"operationId":"jobFieldStateOrReceipt","parameters":[{"name":"operation_id","in":"query","schema":{"type":"string","format":"uuid"},"description":"Look up the acting user/client's immutable nonsensitive receipt, including after Job access loss."}],"responses":{"200":{"description":"Current authorized values/revisions, or operation receipt when operation_id is supplied","content":{"application/json":{"schema":{"type":"object","required":["data"],"properties":{"data":{"oneOf":[{"$ref":"#/components/schemas/JobFieldState"},{"$ref":"#/components/schemas/JobFieldReceipt"}]}}}}}},"default":{"$ref":"#/components/responses/Error"}}},
   "patch":{"operationId":"patchJobFields","description":"Independent job.fields.edit at J or A; planning grants never suffice. Per-field revision checks and all changed-value validation commit atomically with audit and receipt. Unrelated missing required values defer. Same-intent replay has no new effect. Terminal repair needs a new reviewed operation ID; transient retry retains the original. No legacy unguarded PATCH.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobFieldPatch"}}}},"responses":{"200":{"description":"Accepted or same-intent receipt replay. Current values are withheld after access loss.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/JobFieldState"}}}}}},"409":{"description":"Terminal conflict; comparison is currently authorized data only; error.recovery is new_reviewed_operation","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ErrorEnvelope"},{"type":"object","properties":{"comparison":{"$ref":"#/components/schemas/JobFieldState"}}}]}}}},"default":{"$ref":"#/components/responses/Error"}}}
  },
  "/estimates":{"post":{"operationId":"createEstimate","requestBody":{"$ref":"#/components/requestBodies/CommercialCreate"},"responses":{"200":{"description":"Immutable effect receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommercialReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/invoices":{"post":{"operationId":"createInvoice","requestBody":{"$ref":"#/components/requestBodies/CommercialCreate"},"responses":{"200":{"description":"Immutable effect receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommercialReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/estimates/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"get":{"operationId":"getEstimate","responses":{"200":{"description":"Job-linked, currently authorized Estimate; captured pricing omitted without its independent View grant"},"default":{"$ref":"#/components/responses/Error"}}},"patch":{"operationId":"editEstimate","requestBody":{"$ref":"#/components/requestBodies/CommercialEdit"},"responses":{"200":{"description":"Immutable effect receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommercialReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/invoices/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"get":{"operationId":"getInvoice","responses":{"200":{"description":"Job-linked, currently authorized Invoice; captured pricing omitted without its independent View grant; due_date null means No Due Date"},"default":{"$ref":"#/components/responses/Error"}}},"patch":{"operationId":"editInvoice","requestBody":{"$ref":"#/components/requestBodies/CommercialEdit"},"responses":{"200":{"description":"Immutable effect receipt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommercialReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/commercial-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"commercialReceipt","responses":{"200":{"description":"Original disposition and nonsensitive effect identity, including after scope loss","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommercialReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfers/lookup":{"post":{"operationId":"lookupOwnTransferDigest","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["object_type","object_id","sha256"],"properties":{"object_type":{"enum":["job","estimate","invoice"]},"object_id":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}},"responses":{"200":{"description":"This user's paired session and original parent's verified transfer; reuse its identity, never retarget","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerifiedTransferEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/files/limits":{"get":{"operationId":"fileTransferLimits","responses":{"200":{"description":"Current authenticated transfer bounds","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileLimitsEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfers":{"post":{"operationId":"startFileTransfer","parameters":[{"$ref":"#/components/parameters/OperationID"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransferRequest"}}}},"responses":{"201":{"description":"Durable transfer identity; not publication","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransferEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfer-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"fileTransferReceipt","responses":{"200":{"description":"Immutable disposition and transfer effect identity only; available to the original authenticated user/client after parent access loss","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileTransferReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"fileOperationReceipt","responses":{"200":{"description":"Immutable File publication or mutation disposition without parent metadata, names or bytes","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfers/{transfer}":{"parameters":[{"$ref":"#/components/parameters/TransferID"}],"get":{"operationId":"fileTransferStatus","responses":{"200":{"description":"Current caller/client/original-parent scoped transport progress","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransferEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfers/{transfer}/chunks":{"parameters":[{"$ref":"#/components/parameters/TransferID"}],"put":{"operationId":"appendFileTransferChunk","parameters":[{"$ref":"#/components/parameters/OperationID"},{"name":"offset","in":"query","required":true,"schema":{"type":"integer","minimum":0}}],"requestBody":{"required":true,"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary","description":"1 through 1048576 raw bytes; retry exact original segment at original offset and operation ID"}}}},"responses":{"200":{"description":"Durably stored transport progress; unverified","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransferEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/file-transfers/{transfer}/verify":{"parameters":[{"$ref":"#/components/parameters/TransferID"}],"post":{"operationId":"verifyFileTransfer","responses":{"200":{"description":"Fresh exact-byte SHA-256 and content-extension verification; no File publication","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerifiedTransferEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/files/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"get":{"operationId":"downloadFile","parameters":[{"name":"Range","in":"header","schema":{"type":"string"}},{"name":"If-Range","in":"header","schema":{"type":"string"}},{"name":"If-None-Match","in":"header","schema":{"type":"string"}}],"responses":{"200":{"description":"Exact authoritative File bytes, using the recorded File MIME type","headers":{"ETag":{"schema":{"type":"string"}},"Repr-Digest":{"schema":{"type":"string"}}},"content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"206":{"description":"Requested range; multipart/byteranges for multiple ranges","headers":{"ETag":{"schema":{"type":"string"}},"Repr-Digest":{"schema":{"type":"string"}},"Content-Range":{"schema":{"type":"string"}}},"content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"304":{"description":"Representation unchanged"},"416":{"$ref":"#/components/responses/Error"},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/activity":{"$ref":"#/components/pathItems/Activity"},
  "/estimates/{id}/activity":{"$ref":"#/components/pathItems/Activity"},
  "/invoices/{id}/activity":{"$ref":"#/components/pathItems/Activity"},
  "/time-entries/clock-in":{"post":{"operationId":"clockIn","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockCommand"}}}},"responses":{"200":{"description":"Immutable receipt; same intent creates once","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/clock-in":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"post":{"operationId":"clockInToJob","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockCommand"}}}},"responses":{"200":{"description":"Clock into the exact active authorized Job, never standalone fallback","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/clock-out":{"post":{"operationId":"clockOutExactEntry","requestBody":{"required":true,"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ClockCommand"},{"required":["entry_id"]}]}}}},"responses":{"200":{"description":"Exact own entry out; same recorded offline end is a no-op; differing end requires web correction","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/active":{"get":{"operationId":"activeOwnClock","responses":{"200":{"description":"Own exact active entry, with no Job context, notes or GPS","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":["object","null"],"properties":{"id":{"type":"integer"},"user_id":{"type":"integer"},"clock_in":{"type":"string","format":"date-time"},"clock_out":{"type":"null"}}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/lease":{"post":{"operationId":"issueClockStagingLease","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Device-bound 24-hour staging window; acceptance always rechecks current authority","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","required":["id","issued_at","expires_at"],"properties":{"id":{"type":"string","format":"uuid"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"clockReceipt","responses":{"200":{"description":"Same user/device nonsensitive terminal receipt after Job scope loss","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/":{"get":{"operationId":"discover","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Minimal public discovery","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscoveryEnvelope"}}}}}}},
  "/session":{"post":{"operationId":"retiredPasswordLogin","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"410":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"logout","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Current bearer revoked"},"401":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings":{"post":{"operationId":"startPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Separate device secret and displayed user code; expires ten minutes after creation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/redeem":{"post":{"operationId":"redeemPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RedeemRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Only delivery of the opaque bearer; never recoverable by replay","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BearerEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/cancel":{"post":{"operationId":"cancelPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Pending or approved pairing cancelled; repeated same-operation cancellation has no additional effect"},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/me":{"get":{"operationId":"identity","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current online identity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IdentityEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/capabilities":{"get":{"operationId":"capabilities","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current effective grants and request budgets, not an authorization promise","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapabilitiesEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions":{"get":{"operationId":"ownSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Own sessions without token material","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SessionsEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"revokeAllOwnSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"All own sessions revoked, including acting session"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions/{sessionID}":{"parameters":[{"name":"sessionID","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"delete":{"operationId":"revokeOwnSession","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Own session revoked or already revoked"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}}
 },
 "components":{
  "pathItems":{"Activity":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"get":{"summary":"Current-authority operational history for an active Job or Job-bound document","description":"Acceptance time and stable ID descending. Current row and facet Views apply before pagination. From is inclusive; until is exclusive. Unknown or repeated filters and filter-mismatched cursors reject. Customer-only documents, archived Jobs, administrative history and exports are not exposed here.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},{"name":"actor","in":"query","schema":{"type":"integer","minimum":1}},{"name":"action","in":"query","schema":{"type":"string","minLength":1,"maxLength":100}},{"name":"from","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"until","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"cursor","in":"query","schema":{"type":"string","maxLength":1024}}],"responses":{"200":{"description":"Complete authorized page; occurrence is absent when unknown","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActivityEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"},"default":{"$ref":"#/components/responses/Error"}}}}},
  "parameters":{"OperationID":{"name":"Operation-ID","in":"header","required":true,"description":"Client-generated mutation UUID, independent of transfer and publication identities. Retain for unchanged retry; terminal repair requires a new reviewed UUID.","schema":{"type":"string","format":"uuid"}},"JobID":{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}},"TransferID":{"name":"transfer","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}},
  "requestBodies":{
   "CommercialCreate":{"required":true,"description":"Create once using a new client identity and operation identity. Job required; Customer-only fallback forbidden. Omitted defaults resolve explicit > Customer > company once. Invoice date defaults to company today. Optional date empty string explicitly clears/default-suppresses it.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/CommercialCommand"},{"required":["client_id","title"]}]}}}},
   "CommercialEdit":{"required":true,"description":"Atomic patch against the originally read whole-commercial revision and Job. Disjoint stale/ABA edits conflict. Terminal rejection requires a new reviewed operation ID. Changed Custom Fields validate; unrelated missing required fields defer to online details save.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/CommercialCommand"},{"required":["revision"]}]}}}}
  },
  "securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"Opaque paired mobile session. Authorization: Bearer <token>. Cookies are not API credentials."}},
  "responses":{"Error":{"description":"Typed error. Inspect code and recovery_disposition, never parse message. 429 includes Retry-After (seconds). Unknown codes require explicit review.","headers":{"Retry-After":{"schema":{"type":"string","pattern":"^[0-9]+$"}},"X-Request-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},
  "schemas":{
   "JobNotesCommand":{"type":"object","additionalProperties":false,"required":["operation_id","notes_revision","field_notes"],"properties":{"operation_id":{"type":"string","format":"uuid"},"notes_revision":{"type":"string"},"field_notes":{"type":"string"},"occurred_at":{"type":"string","format":"date-time"}}},
   "JobStatusCommand":{"type":"object","additionalProperties":false,"required":["operation_id","status_id","status_revision","meaning_revision"],"properties":{"operation_id":{"type":"string","format":"uuid"},"status_id":{"type":"integer","minimum":1},"status_revision":{"type":"string"},"meaning_revision":{"type":"string"},"occurred_at":{"type":"string","format":"date-time"}}},
   "JobNotesEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["field_notes","notes_revision","review_required","can_edit_notes"],"properties":{"field_notes":{"type":"string"},"notes_revision":{"type":"string"},"review_required":{"type":"boolean"},"can_edit_notes":{"type":"boolean"},"can_review":{"type":"boolean"}}}}},
   "JobExecutionReceiptEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["operation_id","code","accepted_at"],"properties":{"operation_id":{"type":"string","format":"uuid"},"code":{"type":"string"},"effect_id":{"type":"string","format":"uuid"},"accepted_at":{"type":"string","format":"date-time"}}}}},
   "JobStatusIntentsEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"array","items":{"type":"object","required":["status","intent"],"properties":{"status":{"type":"object","properties":{"id":{"type":"integer"},"name":{"type":"string"},"color":{"type":"string"},"category":{"type":"string"},"order":{"type":"integer"}}},"intent":{"type":"object","required":["status_id","status_revision","meaning_revision"],"properties":{"status_id":{"type":"integer"},"status_revision":{"type":"string"},"meaning_revision":{"type":"string"}}}}}}}},
   "JobNotesHistoryEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"array","items":{"type":"object","properties":{"revision":{"type":"string"},"content":{"type":"string"},"actor_id":{"type":["integer","null"]},"actor_name":{"type":"string"},"accepted_at":{"type":["string","null"],"format":"date-time"},"recorded_at":{"type":"string","format":"date-time"},"baseline":{"type":"boolean"},"baseline_source":{"type":"string"}}}}}},
   "SubtaskIntent":{"type":"object","additionalProperties":false,"required":["operation_id","completion_revision","completed"],"properties":{"operation_id":{"type":"string","format":"uuid"},"completion_revision":{"type":"string","format":"uuid"},"completed":{"type":"boolean"},"occurred_at":{"type":"string","format":"date-time","description":"Optional client occurrence evidence, never authority or ordering; may not be future."}}},
