{
 "openapi":"3.1.0",
 "jsonSchemaDialect":"https://json-schema.org/draft/2020-12/schema",
 "info":{"title":"FreeFSM v1 pairing and own-session protocol","version":"1.0.0","description":"Interactive user protocol. Ten-minute pairing, authenticated hosted browser approval, one-use opaque bearer. This document publishes the pairing/session boundary; field-domain contracts evolve in their owning slices. No API password or refresh-token flow."},
 "servers":[{"url":"/api/v1"}],
 "security":[{"bearer":[]}],
 "paths":{
  "/time-entries/clock-in":{"post":{"operationId":"clockIn","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockCommand"}}}},"responses":{"200":{"description":"Immutable receipt; same intent creates once","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/jobs/{id}/clock-in":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"post":{"operationId":"clockInToJob","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockCommand"}}}},"responses":{"200":{"description":"Clock into the exact active authorized Job, never standalone fallback","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/clock-out":{"post":{"operationId":"clockOutExactEntry","requestBody":{"required":true,"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/ClockCommand"},{"required":["entry_id"]}]}}}},"responses":{"200":{"description":"Exact own entry out; same recorded offline end is a no-op; differing end requires web correction","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/active":{"get":{"operationId":"activeOwnClock","responses":{"200":{"description":"Own exact active entry, with no Job context, notes or GPS","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":["object","null"],"properties":{"id":{"type":"integer"},"user_id":{"type":"integer"},"clock_in":{"type":"string","format":"date-time"},"clock_out":{"type":"null"}}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-entries/lease":{"post":{"operationId":"issueClockStagingLease","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Device-bound 24-hour staging window; acceptance always rechecks current authority","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","required":["id","issued_at","expires_at"],"properties":{"id":{"type":"string","format":"uuid"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/time-operations/{operation}":{"parameters":[{"name":"operation","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"clockReceipt","responses":{"200":{"description":"Same user/device nonsensitive terminal receipt after Job scope loss","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClockReceiptEnvelope"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
  "/":{"get":{"operationId":"discover","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Minimal public discovery","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscoveryEnvelope"}}}}}}},
  "/session":{"post":{"operationId":"retiredPasswordLogin","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"410":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"logout","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Current bearer revoked"},"401":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings":{"post":{"operationId":"startPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Separate device secret and displayed user code; expires ten minutes after creation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/redeem":{"post":{"operationId":"redeemPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RedeemRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Only delivery of the opaque bearer; never recoverable by replay","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BearerEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/cancel":{"post":{"operationId":"cancelPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Pending or approved pairing cancelled; repeated same-operation cancellation has no additional effect"},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/me":{"get":{"operationId":"identity","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current online identity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IdentityEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/capabilities":{"get":{"operationId":"capabilities","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current effective grants and request budgets, not an authorization promise","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapabilitiesEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions":{"get":{"operationId":"ownSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Own sessions without token material","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SessionsEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"revokeAllOwnSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"All own sessions revoked, including acting session"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions/{sessionID}":{"parameters":[{"name":"sessionID","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"delete":{"operationId":"revokeOwnSession","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Own session revoked or already revoked"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}}
 },
 "components":{
  "securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"Opaque paired mobile session. Authorization: Bearer <token>. Cookies are not API credentials."}},
  "responses":{"Error":{"description":"Typed error. Inspect code and recovery_disposition, never parse message. 429 includes Retry-After (seconds). Unknown codes require explicit review.","headers":{"Retry-After":{"schema":{"type":"string","pattern":"^[0-9]+$"}},"X-Request-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},
  "schemas":{
   "ClockCommand":{"type":"object","additionalProperties":false,"required":["operation_id"],"properties":{"operation_id":{"type":"string","format":"uuid"},"entry_id":{"type":"integer","minimum":1},"job_id":{"type":"integer","minimum":1},"notes":{"type":"string","description":"Clock-in only"},"occurred_at":{"type":"string","format":"date-time","description":"Staged occurrence, requires lease_id. Omit for online server-time clock."},"lease_id":{"type":"string","format":"uuid"},"gps":{"type":"object","additionalProperties":false,"required":["latitude","longitude","captured_at"],"properties":{"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"captured_at":{"type":"string","format":"date-time"},"accuracy":{"type":"number","minimum":0}}}}},
   "ClockReceiptEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["operation_id","code","accepted_at"],"properties":{"operation_id":{"type":"string","format":"uuid"},"entry_id":{"type":"integer","minimum":1},"code":{"type":"string"},"accepted_at":{"type":"string","format":"date-time"}}}}},
   "StartRequest":{"type":"object","additionalProperties":false,"required":["device_name","operation_id"],"properties":{"device_name":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^\u0000-\u001f\u007f-\u009f]+$"},"operation_id":{"type":"string","format":"uuid"}}},
   "RedeemRequest":{"type":"object","additionalProperties":false,"required":["device_code","operation_id"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"operation_id":{"type":"string","format":"uuid"}}},
   "CancelRequest":{"type":"object","additionalProperties":false,"required":["device_code","operation_id"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"operation_id":{"type":"string","format":"uuid"}}},
   "ErrorEnvelope":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","request_id","details","recovery_disposition"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"string","format":"uuid"},"details":{"type":"object"},"recovery_disposition":{"type":"string","enum":["purge","locked_review","retry","review"]},"retry_after_seconds":{"type":"integer","minimum":1}}}}},
   "DiscoveryEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","additionalProperties":false,"required":["api_major","server_time","pairing","recovery","documentation"],"properties":{"api_major":{"const":1},"server_time":{"type":"string","format":"date-time"},"pairing":{"const":"/api/v1/pairings"},"recovery":{"const":"/forgot-password"},"documentation":{"const":"/api/v1/docs"}}}}},
   "StartEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["device_code","user_code","expires_at","verification_uri"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"user_code":{"type":"string","pattern":"^[A-F0-9]{16}$"},"expires_at":{"type":"string","format":"date-time"},"verification_uri":{"const":"/pair"}}}}},
   "BearerEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["token","token_type","inactivity_seconds"],"properties":{"token":{"type":"string","pattern":"^[a-f0-9]{64}$"},"token_type":{"const":"Bearer"},"inactivity_seconds":{"const":2592000}}}}},
   "IdentityEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["id","company_id","name","email","role"],"properties":{"id":{"type":"integer","minimum":1},"company_id":{"type":"integer","minimum":1},"name":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","description":"Legacy display label; never an authorization condition"}}}}},
   "CapabilitiesEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["grants","limits","window_seconds"],"properties":{"grants":{"type":"array","items":{"type":"object","required":["permission","scope"],"properties":{"permission":{"type":"string"},"scope":{"enum":["A","J","C","O","U","S"]}}}},"window_seconds":{"const":60},"limits":{"type":"object","required":["auth_per_login","auth_per_ip","requests_per_user","sync_per_client"],"properties":{"auth_per_login":{"type":"integer","minimum":1},"auth_per_ip":{"type":"integer","minimum":1},"requests_per_user":{"type":"integer","minimum":1},"sync_per_client":{"type":"integer","minimum":1}}}}}}},
   "SessionsEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"array","items":{"type":"object","required":["id","kind","device","issued_at","last_authorized_at","expires_at","current","review_required","legacy_recorded_metadata"],"properties":{"id":{"type":"integer","minimum":1},"kind":{"enum":["web","mobile"]},"device":{"type":"string"},"issued_at":{"type":"string","format":"date-time"},"last_authorized_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"revoked_at":{"type":"string","format":"date-time"},"current":{"type":"boolean"},"review_required":{"type":"boolean"},"legacy_recorded_metadata":{"type":"boolean"},"legacy_evidence":{"type":"object"}}}}}}
  }
 }
}
