{
 "openapi":"3.1.0",
 "jsonSchemaDialect":"https://json-schema.org/draft/2020-12/schema",
  "info":{"title":"FreeFSM v1 pairing, own sessions and Job sync","version":"1.1.0","description":"Interactive user protocol. Ten-minute pairing, authenticated hosted browser approval, one-use opaque bearer and coherent authorized Job-context reads. Later field-domain contracts evolve in their owning slices. No API password or refresh-token flow."},
 "servers":[{"url":"/api/v1"}],
 "security":[{"bearer":[]}],
  "paths":{
  "/sync/jobs":{"get":{"operationId":"syncJobs","description":"Read-only authorized Job-context snapshot or delta. Every parameter occurs at most once. Unknown parameters and simultaneous cursor/page are invalid_request (400). Keep scope and page_size identical throughout a chain. Initial snapshot replaces the selected scope; records are complete replacements keyed by opaque ID, removed IDs purge even prior staged pages. Apply the whole page atomically before advancing next_page; promote completion_cursor only after final local application. Never decode tokens. Replay is idempotent state, not history. Current authority is checked every page. Continuity is at least 30 days; unsafe/expired tokens require purge and resnapshot. Default sync budget 12/min/client is discoverable and configurable.","parameters":[{"name":"cursor","in":"query","schema":{"type":"string","minLength":1}},{"name":"page","in":"query","schema":{"type":"string","minLength":1}},{"name":"page_size","in":"query","schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},{"name":"scope","in":"query","schema":{"type":"string","enum":["assigned","all"],"default":"assigned"},"description":"all requires Job View A. Context facets always require explicit current assignment and independent grants."}],"responses":{"200":{"description":"Stable materialized page at watermark; completion token only on last page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobSyncEnvelope"},"example":{"data":{"records":[],"removed":[],"next_page":null,"completion_cursor":"opaque-completion-token","watermark":"2026-10-14T12:00:00Z","complete":true,"purge":"none"}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"409":{"description":"Expired, unsafe, cross-client or filter-mismatched continuity. Discard all cached Job/context and tokens before a fresh snapshot.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobSyncResnapshotEnvelope"}}}},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/":{"get":{"operationId":"discover","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Minimal public discovery","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscoveryEnvelope"}}}}}}},
  "/session":{"post":{"operationId":"retiredPasswordLogin","security":[],"responses":{"default":{"$ref":"#/components/responses/Error"},"410":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"logout","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Current bearer revoked"},"401":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings":{"post":{"operationId":"startPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Separate device secret and displayed user code; expires ten minutes after creation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/redeem":{"post":{"operationId":"redeemPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RedeemRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"201":{"description":"Only delivery of the opaque bearer; never recoverable by replay","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BearerEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/pairings/cancel":{"post":{"operationId":"cancelPairing","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelRequest"}}}},"responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Pending or approved pairing cancelled; repeated same-operation cancellation has no additional effect"},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/me":{"get":{"operationId":"identity","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current online identity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IdentityEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/capabilities":{"get":{"operationId":"capabilities","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Current effective grants and request budgets, not an authorization promise","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapabilitiesEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions":{"get":{"operationId":"ownSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"200":{"description":"Own sessions without token material","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SessionsEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}},"delete":{"operationId":"revokeAllOwnSessions","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"All own sessions revoked, including acting session"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
  "/sessions/{sessionID}":{"parameters":[{"name":"sessionID","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"delete":{"operationId":"revokeOwnSession","responses":{"default":{"$ref":"#/components/responses/Error"},"204":{"description":"Own session revoked or already revoked"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}}
 },
 "components":{
  "securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"Opaque paired mobile session. Authorization: Bearer <token>. Cookies are not API credentials."}},
  "responses":{"Error":{"description":"Typed error. Inspect code and recovery_disposition, never parse message. 429 includes Retry-After (seconds). Unknown codes require explicit review.","headers":{"Retry-After":{"schema":{"type":"string","pattern":"^[0-9]+$"}},"X-Request-ID":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},
  "schemas":{
   "StartRequest":{"type":"object","additionalProperties":false,"required":["device_name","operation_id"],"properties":{"device_name":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^\u0000-\u001f\u007f-\u009f]+$"},"operation_id":{"type":"string","format":"uuid"}}},
   "RedeemRequest":{"type":"object","additionalProperties":false,"required":["device_code","operation_id"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"operation_id":{"type":"string","format":"uuid"}}},
   "CancelRequest":{"type":"object","additionalProperties":false,"required":["device_code","operation_id"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"operation_id":{"type":"string","format":"uuid"}}},
   "ErrorEnvelope":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","request_id","details","recovery_disposition"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"string","format":"uuid"},"details":{"type":"object"},"recovery_disposition":{"type":"string","enum":["purge","purge_and_resnapshot","locked_review","retry","review"]},"retry_after_seconds":{"type":"integer","minimum":1}}}}},
   "JobSyncResnapshotEnvelope":{"allOf":[{"$ref":"#/components/schemas/ErrorEnvelope"},{"properties":{"error":{"properties":{"code":{"const":"resnapshot_required"},"recovery_disposition":{"const":"purge_and_resnapshot"},"details":{"type":"object","additionalProperties":false,"required":["purge"],"properties":{"purge":{"const":"all"}}}}}}}]},
   "OpaqueID":{"type":"string","minLength":1,"description":"Opaque persistent identity, never decode, infer an installed integer ID or reuse."},
   "SyncDate":{"type":["string","null"],"format":"date"},
   "SyncInstant":{"type":["string","null"],"format":"date-time"},
   "SyncCustomer":{"type":"object","additionalProperties":false,"required":["id","display_name","first_name","last_name","organization_name","kind","phone","email","service_notes"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"display_name":{"type":"string"},"first_name":{"type":"string"},"last_name":{"type":"string"},"organization_name":{"type":"string"},"kind":{"type":"string","enum":["Individual","Organization",""],"description":"Empty legacy Kind remains unspecified, never inferred."},"phone":{"type":"string"},"email":{"type":"string"},"service_notes":{"type":"string"}}},
   "SyncContact":{"type":"object","additionalProperties":false,"required":["id","name","role_title","phone","email","service_notes"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"name":{"type":"string"},"role_title":{"type":"string"},"phone":{"type":"string"},"email":{"type":"string"},"service_notes":{"type":"string"}}},
   "SyncLocation":{"type":"object","additionalProperties":false,"required":["id","title","address_1","address_2","city","state","zip_code","latitude","longitude","access_notes","service_notes"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"title":{"type":"string"},"address_1":{"type":"string"},"address_2":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip_code":{"type":"string"},"latitude":{"type":["number","null"],"minimum":-90,"maximum":90},"longitude":{"type":["number","null"],"minimum":-180,"maximum":180},"access_notes":{"type":"string"},"service_notes":{"type":"string"}}},
   "SyncAssetLocation":{"type":["object","null"],"additionalProperties":false,"required":["id","title"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"title":{"type":"string"}}},
   "SyncAsset":{"type":"object","additionalProperties":false,"required":["id","number","name","ownership_class","type","status","serial_number","manufacturer","model","installed_at","warranty_expires","location","service_notes"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"number":{"type":"string"},"name":{"type":"string"},"ownership_class":{"enum":["customer_owned","company_owned"]},"type":{"type":"string"},"status":{"type":"string"},"serial_number":{"type":"string"},"manufacturer":{"type":"string"},"model":{"type":"string"},"installed_at":{"$ref":"#/components/schemas/SyncDate"},"warranty_expires":{"$ref":"#/components/schemas/SyncDate"},"location":{"$ref":"#/components/schemas/SyncAssetLocation"},"service_notes":{"type":"string"}}},
   "SyncProject":{"type":"object","additionalProperties":false,"required":["name","description","status","progress","planned_start_date","planned_end_date","location","service_notes"],"properties":{"name":{"type":"string"},"description":{"type":"string"},"status":{"type":"string"},"progress":{"type":"integer","minimum":0,"maximum":100},"planned_start_date":{"$ref":"#/components/schemas/SyncDate"},"planned_end_date":{"$ref":"#/components/schemas/SyncDate"},"location":{"type":"string"},"service_notes":{"type":"string"}}},
   "SyncProjectReference":{"type":"object","additionalProperties":false,"required":["name","archived"],"properties":{"name":{"type":"string"},"archived":{"const":true}}},
   "SyncMasters":{"type":"object","additionalProperties":false,"properties":{"contact":{"$ref":"#/components/schemas/SyncContact"},"contacts":{"type":"array","items":{"$ref":"#/components/schemas/SyncContact"}},"location":{"$ref":"#/components/schemas/SyncLocation"},"asset":{"$ref":"#/components/schemas/SyncAsset"},"assets":{"type":"array","items":{"$ref":"#/components/schemas/SyncAsset"}},"project":{"$ref":"#/components/schemas/SyncProject"},"project_reference":{"$ref":"#/components/schemas/SyncProjectReference"}}},
   "SyncJob":{"type":"object","additionalProperties":false,"required":["id","title","description","field_notes","status","start_time","end_time","due_date","arrival_window_start","arrival_window_end","timezone","masters"],"properties":{"id":{"$ref":"#/components/schemas/OpaqueID"},"title":{"type":"string"},"description":{"type":"string"},"field_notes":{"type":"string"},"status":{"type":"object","additionalProperties":false,"required":["name","category"],"properties":{"name":{"type":"string"},"category":{"enum":["job:new","job:travel_time","job:in_progress","job:pending","job:completed","job:canceled",""],"description":"Empty when no Status was recorded on installed data; do not infer a category."}}},"start_time":{"$ref":"#/components/schemas/SyncInstant"},"end_time":{"$ref":"#/components/schemas/SyncInstant"},"due_date":{"$ref":"#/components/schemas/SyncDate"},"arrival_window_start":{"$ref":"#/components/schemas/SyncInstant"},"arrival_window_end":{"$ref":"#/components/schemas/SyncInstant"},"timezone":{"type":"string","minLength":1,"description":"IANA timezone name (including UTC); instants carry explicit RFC3339 offsets."},"customer":{"$ref":"#/components/schemas/SyncCustomer"},"masters":{"$ref":"#/components/schemas/SyncMasters"}}},
   "JobSyncEnvelope":{"type":"object","additionalProperties":false,"required":["data"],"properties":{"data":{"type":"object","additionalProperties":false,"required":["records","removed","next_page","completion_cursor","watermark","complete","purge"],"properties":{"records":{"type":"array","maxItems":200,"items":{"$ref":"#/components/schemas/SyncJob"}},"removed":{"type":"array","uniqueItems":true,"items":{"$ref":"#/components/schemas/OpaqueID"}},"next_page":{"type":["string","null"],"minLength":1},"completion_cursor":{"type":["string","null"],"minLength":1},"watermark":{"type":"string","format":"date-time"},"complete":{"type":"boolean"},"purge":{"const":"none"}},"oneOf":[{"properties":{"complete":{"const":true},"next_page":{"type":"null"},"completion_cursor":{"type":"string"}}},{"properties":{"complete":{"const":false},"next_page":{"type":"string"},"completion_cursor":{"type":"null"}}}]}}},
   "DiscoveryEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","additionalProperties":false,"required":["api_major","server_time","pairing","recovery","documentation"],"properties":{"api_major":{"const":1},"server_time":{"type":"string","format":"date-time"},"pairing":{"const":"/api/v1/pairings"},"recovery":{"const":"/forgot-password"},"documentation":{"const":"/api/v1/docs"}}}}},
   "StartEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["device_code","user_code","expires_at","verification_uri"],"properties":{"device_code":{"type":"string","pattern":"^[a-f0-9]{64}$"},"user_code":{"type":"string","pattern":"^[A-F0-9]{16}$"},"expires_at":{"type":"string","format":"date-time"},"verification_uri":{"const":"/pair"}}}}},
   "BearerEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["token","token_type","inactivity_seconds"],"properties":{"token":{"type":"string","pattern":"^[a-f0-9]{64}$"},"token_type":{"const":"Bearer"},"inactivity_seconds":{"const":2592000}}}}},
   "IdentityEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["id","company_id","name","email","role"],"properties":{"id":{"type":"integer","minimum":1},"company_id":{"type":"integer","minimum":1},"name":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","description":"Legacy display label; never an authorization condition"}}}}},
   "CapabilitiesEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["grants","limits","window_seconds"],"properties":{"sync":{"$ref":"#/components/schemas/JobSyncDiscovery"},"grants":{"type":"array","items":{"type":"object","required":["permission","scope"],"properties":{"permission":{"type":"string"},"scope":{"enum":["A","J","C","O","U","S"]}}}},"window_seconds":{"const":60},"limits":{"type":"object","required":["auth_per_login","auth_per_ip","requests_per_user","sync_per_client"],"properties":{"auth_per_login":{"type":"integer","minimum":1},"auth_per_ip":{"type":"integer","minimum":1},"requests_per_user":{"type":"integer","minimum":1},"sync_per_client":{"type":"integer","minimum":1}}}}}}},
   "JobSyncDiscovery":{"type":"object","required":["endpoint","available","scopes","default_page_size","max_page_size","continuity_days","filters"],"properties":{"endpoint":{"const":"/api/v1/sync/jobs"},"available":{"type":"boolean"},"scopes":{"type":"array","uniqueItems":true,"items":{"enum":["assigned","all"]}},"default_page_size":{"const":50},"max_page_size":{"const":200},"continuity_days":{"const":30},"filters":{"const":["scope"]}}},
   "SessionsEnvelope":{"type":"object","required":["data"],"properties":{"data":{"type":"array","items":{"type":"object","required":["id","kind","device","issued_at","last_authorized_at","expires_at","current","review_required","legacy_recorded_metadata"],"properties":{"id":{"type":"integer","minimum":1},"kind":{"enum":["web","mobile"]},"device":{"type":"string"},"issued_at":{"type":"string","format":"date-time"},"last_authorized_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"revoked_at":{"type":"string","format":"date-time"},"current":{"type":"boolean"},"review_required":{"type":"boolean"},"legacy_recorded_metadata":{"type":"boolean"},"legacy_evidence":{"type":"object"}}}}}}
  }
 }
}
