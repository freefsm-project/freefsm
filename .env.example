FREEFSM_DB_HOST=localhost
FREEFSM_DB_PORT=5432
FREEFSM_DB_NAME=freefsm
FREEFSM_DB_USER=freefsm
FREEFSM_DB_PASSWORD=changeme
FREEFSM_DB_SSLMODE=disable

FREEFSM_ADDR=:3000
FREEFSM_LOG_LEVEL=info
FREEFSM_SESSION_SECRET=generate-a-random-secret-here
FREEFSM_SETUP_TOKEN=generate-a-random-setup-token-here
FREEFSM_PUBLIC_URL=http://localhost:3000

# Optional SMTP credential encryption: comma-separated base64-encoded 32-byte
# operator keys, active write key first. Generate each with openssl rand -base64 32.
# Required before saving an SMTP password. Retain original keys for old backups.
# FREEFSM_CREDENTIAL_KEYS=

FREEFSM_UPLOAD_DIR=./uploads
FREEFSM_MAX_UPLOAD_SIZE=26214400
