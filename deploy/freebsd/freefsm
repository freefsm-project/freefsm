#!/bin/sh
#
# PROVIDE: freefsm
# REQUIRE: LOGIN postgresql
# KEYWORD: shutdown
#
# FreeBSD rc.d script for FreeFSM.
# Build the binary with GNU Make: gmake build
# Install with: gmake install-freebsd

. /etc/rc.subr

name="freefsm"
rcvar="freefsm_enable"

load_rc_config "$name"

: ${freefsm_enable:="NO"}
: ${freefsm_user:="freefsm"}
: ${freefsm_config:="/usr/local/etc/freefsm.conf"}

pidfile="/var/run/freefsm.pid"
command="/usr/local/bin/freefsm"
# -P records the supervisor, not its application child. rc.subr must check
# that identity for status (and for the guarded stop below).
procname="/usr/sbin/daemon"

start_cmd="freefsm_start"
stop_cmd="freefsm_stop"

freefsm_start() {
    echo "Starting ${name}."
    # Close inherited SSH/console descriptors in the supervisor. Application
    # stdout/stderr go to syslog; only the application opens its configured log.
    /usr/sbin/daemon -f -P "${pidfile}" -u "${freefsm_user}" \
        -S -T freefsm \
        "${command}" -config "${freefsm_config}"
}

freefsm_stop() {
    if [ -f "${pidfile}" ]; then
        read _pid < "${pidfile}"
        if [ -n "$(check_pidfile "${pidfile}" "${procname}")" ]; then
            echo "Stopping ${name}."
            kill "${_pid}" && wait_for_pids "${_pid}"
        fi
        rm -f "${pidfile}"
    else
        echo "${name} not running? (check ${pidfile})"
    fi
}

run_rc_command "$1"
